<Window x:Class="RentalManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:RentalManager.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Quản lý nhà trọ" Icon="Assets/appicon.ico" Height="780" Width="1240" MinHeight="680" MinWidth="1040">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,4,2"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline5TextBlock}">
            <Setter Property="Margin" Value="10,8,10,2"/>
        </Style>
        <Style x:Key="RightCell" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="GroupBox" BasedOn="{StaticResource MaterialDesignCardGroupBox}">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryMid" Padding="16">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="HomeCity" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Quản lý nhà trọ" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Tháng" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="White"/>
                    <ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedBillingMonth}" Width="70" Foreground="White" materialDesign:HintAssist.Foreground="White"/>
                    <TextBlock Text="Năm" VerticalAlignment="Center" Margin="16,0,4,0" Foreground="White"/>
                    <ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedBillingYear}" Width="90" Foreground="White" materialDesign:HintAssist.Foreground="White"/>
                    <Button Content="Làm mới" Command="{Binding RefreshCommand}" Margin="16,0,0,0" Style="{StaticResource MaterialDesignOutlinedLightButton}"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource MaterialDesignPaper}">
            <StatusBarItem Content="{Binding StatusMessage}"/>
        </StatusBar>

                <TabControl x:Name="MainTabs" TabStripPlacement="Left" Margin="0,4,0,0">
            <TabItem x:Name="DashboardTab" Header="Tổng quan">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Tổng quan tháng"/>
                    <GroupBox DockPanel.Dock="Top" Header="Bộ lọc">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tháng"/><ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedBillingMonth}" Width="90"/></StackPanel>
                            <StackPanel><TextBlock Text="Năm"/><ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding DashboardYear}" Width="90"/></StackPanel>
                            <StackPanel><TextBlock Text="Khoảng thời gian"/><ComboBox ItemsSource="{Binding DashboardRangeOptions}" SelectedItem="{Binding DashboardRange}" Width="170"/></StackPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding PropertyFilterOptions}" SelectedValue="{Binding DashboardPropertyFilterId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="190"/></StackPanel>
                            <TextBlock Text="{Binding ActiveDashboardPeriod}" FontWeight="SemiBold" Margin="12,18,4,0"/>
                        </WrapPanel>
                    </GroupBox>
                    <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="6" Margin="8">
                        <GroupBox Header="Dự kiến thu"><TextBlock Text="{Binding Dashboard.ExpectedRevenue, StringFormat=N0}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Đã thu"><TextBlock Text="{Binding Dashboard.CollectedAmount, StringFormat=N0}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Chưa thu"><TextBlock Text="{Binding Dashboard.UnpaidAmount, StringFormat=N0}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Phòng đang thuê"><TextBlock Text="{Binding Dashboard.OccupiedRoomCount}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Phòng trống"><TextBlock Text="{Binding Dashboard.VacantRoomCount}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Hóa đơn chưa trả"><TextBlock Text="{Binding Dashboard.UnpaidInvoiceCount}" FontSize="18"/></GroupBox>
                    </UniformGrid>
                    <Border DockPanel.Dock="Top" Margin="10,0,10,4" Padding="8" Background="#fff7df" BorderBrush="#e2bf65" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Có "/>
                            <TextBlock Text="{Binding Dashboard.MissingReadingCount}" FontWeight="SemiBold"/>
                            <TextBlock Text=" phòng thiếu chỉ số điện/nước trong tháng này."/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Hóa đơn trong tháng" Grid.Column="0">
                            <DataGrid ItemsSource="{Binding DashboardInvoices}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tháng" Binding="{Binding BillingMonth}" Width="75"/>
                                    <DataGridTextColumn Header="Nhà" Binding="{Binding PropertyName}" Width="120"/>
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="90"/>
                                    <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                    <DataGridTextColumn Header="Còn lại" Binding="{Binding RemainingAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Header="Thanh toán gần đây" Grid.Column="1">
                            <DataGrid ItemsSource="{Binding DashboardRecentPayments}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ngày" Binding="{Binding PaymentDate, StringFormat=d}" Width="90"/>
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="90"/>
                                    <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                    <DataGridTextColumn Header="Phương thức" Binding="{Binding MethodText}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>
                                                <TabItem Header="Nhà &amp; Phòng">
                <!-- Internal toggle: Quản lý phòng | Danh mục khoản phí -->
                <TabControl TabStripPlacement="Top">
                    <TabItem Header="Quản lý phòng">
                        <Grid>
                    <!-- ── MAIN CONTENT ── -->
                    <DockPanel Panel.ZIndex="1">
                        <!-- Top action bar -->
                        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <DockPanel>
                                <TextBlock Text="Nhà &amp; Phòng" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                        <Button Content="＋ Thêm phòng" Command="{Binding OpenAddRoomDrawerCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                                    <Button Content="＋ Thêm nhà" Command="{Binding OpenAddPropertyDrawerCommand}" Style="{StaticResource MaterialDesignRaisedButton}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- Property selector strip -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryHueLightBrush}" Padding="8,4">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ListBox ItemsSource="{Binding Properties}" SelectedItem="{Binding SelectedProperty}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                            <Setter Property="Padding" Value="14,6"/>
                                            <Setter Property="Margin" Value="2,0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueLightForegroundBrush}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding Address}" FontSize="10" Opacity="0.75" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>
                        <!-- Room cards -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,12,16,16">
                                <TextBlock Text="Chọn nhà để xem danh sách phòng. Bấm ‘Khoản phí’ trên từng phòng để thêm hoặc quản lý điện, nước, wifi, rác và các phí khác."
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding WorkspacePropertyHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" Opacity="0.8"/>
                                <ItemsControl ItemsSource="{Binding WorkspaceRooms}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <materialDesign:Card Margin="6" Width="290" Padding="0" materialDesign:ElevationAssist.Elevation="Dp2">
                                                <DockPanel>
                                                    <!-- Status bar at top of card -->
                                                    <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryHueLightBrush}" Padding="12,4">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding RoomName}" FontWeight="Bold" FontSize="15"
                                                                       Foreground="{DynamicResource PrimaryHueLightForegroundBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                       Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85"/>
                                                        </DockPanel>
                                                    </Border>
                                                    <!-- Card body -->
                                                    <StackPanel Margin="12,10,12,12">
                                                        <TextBlock Text="{Binding BaseRent, StringFormat='{}{0:N0} ₫'}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                            <materialDesign:PackIcon Kind="AccountCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Opacity="0.55" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding RepresentativeTenantName}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                            <materialDesign:PackIcon Kind="Stairs" Width="14" Height="14" VerticalAlignment="Center" Opacity="0.45" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding Floor, StringFormat='Tầng {0}'}" FontSize="11" Opacity="0.55"/>
                                                        </StackPanel>
                                                        <!-- Action buttons -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Sửa" Margin="0,0,4,0" Height="30" FontSize="12" Padding="8,0"
                                                                    Command="{Binding DataContext.OpenEditRoomDrawerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                            <Button Content="Khoản phí" Margin="0,0,4,0" Height="30" FontSize="12" Padding="8,0"
                                                                    Command="{Binding DataContext.OpenRoomFeeDrawerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                            <Button Content="Trả phòng" Margin="0,0,0,0" Height="30" FontSize="12" Padding="8,0"
                                                                    Command="{Binding DataContext.DeactivateRoomRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </materialDesign:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- ── OVERLAY DIMMER ── -->
                    <Border Panel.ZIndex="50" Background="#70000000"
                            Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDrawerCommand}"/>
                        </Border.InputBindings>
                    </Border>

                    <!-- ── PROPERTY MODAL (centered) ── -->
                    <Border Panel.ZIndex="51"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="500" Margin="40"
                            Background="{DynamicResource MaterialDesignPaper}"
                            CornerRadius="6"
                            Visibility="{Binding IsPropertyDrawerOpen, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="20,14" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="6,6,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding CloseDrawerCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}" Focusable="False"
                                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                    <TextBlock Text="{Binding PropertyFormMode}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <StackPanel Margin="20,16,20,20">
                                <TextBlock Text="Tên nhà / khu trọ" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewProperty.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <TextBlock Text="Địa chỉ" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewProperty.Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <TextBlock Text="Ghi chú" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewProperty.Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Ngừng sử dụng" Command="{Binding DeactivatePropertyCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0" Foreground="{DynamicResource ErrorBrush}" BorderBrush="{DynamicResource ErrorBrush}"/>
                                    <Button Content="Thêm mới" Command="{Binding AddPropertyCommand}" Margin="0,0,8,0" Padding="12,0"/>
                                    <Button Content="Lưu thay đổi" Command="{Binding SavePropertyCommand}" Margin="0,0,8,0" Padding="12,0"/>
                                    <Button Content="Hủy sửa" Command="{Binding CancelPropertyEditCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="12,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ── ROOM MODAL (centered) ── -->
                    <Border Panel.ZIndex="51"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="540" Margin="40"
                            Background="{DynamicResource MaterialDesignPaper}"
                            CornerRadius="6"
                            Visibility="{Binding IsRoomDrawerOpen, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="20,14" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="6,6,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding CloseDrawerCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}" Focusable="False"
                                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                    <TextBlock Text="{Binding RoomFormMode}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <StackPanel Margin="20,16,20,20">
                                <WrapPanel Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,16,0" Width="240">
                                        <TextBlock Text="Nhà / khu trọ" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding Properties}" SelectedValue="{Binding NewRoom.PropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name"/>
                                    </StackPanel>
                                    <StackPanel Width="240">
                                        <TextBlock Text="Tầng" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewRoom.Floor, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </WrapPanel>
                                
                                <TextBlock Text="Tên phòng" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewRoom.RoomName, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="Có thể nhập một phòng hoặc nhiều phòng, phân tách bằng dấu phẩy, chấm phẩy hoặc xuống dòng. Ví dụ: 1.01, 1.02, 1.03" FontSize="11" Opacity="0.6" Margin="0,4,0,14" TextWrapping="Wrap"/>
                                
                                <WrapPanel Margin="0,0,0,20">
                                    <StackPanel Margin="0,0,16,0" Width="240">
                                        <TextBlock Text="Giá thuê mặc định (₫)" Margin="0,0,0,4"/>
                                        <TextBox helpers:MoneyTextBox.Enabled="True" Text="{Binding NewRoom.BaseRent, UpdateSourceTrigger=LostFocus, StringFormat=N0}"/>
                                    </StackPanel>
                                    <StackPanel Width="240">
                                        <TextBlock Text="Trạng thái" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding RoomFormStatusOptions}" SelectedValue="{Binding NewRoom.Status}" SelectedValuePath="Value" DisplayMemberPath="Text"/>
                                    </StackPanel>
                                </WrapPanel>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Trả phòng" Command="{Binding DeactivateRoomCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0" Visibility="{Binding NewRoom.IsOccupied, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Thêm mới" Command="{Binding AddRoomCommand}" Margin="0,0,8,0" Padding="12,0"/>
                                    <Button Content="Lưu thay đổi" Command="{Binding SaveRoomCommand}" Margin="0,0,8,0" Padding="12,0"/>
                                    <Button Content="Hủy sửa" Command="{Binding CancelRoomEditCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="12,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ── ROOM FEE MODAL (centered) ── -->
                    <Border Panel.ZIndex="51"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="860" MaxHeight="680"
                            Width="Auto" MinWidth="600"
                            Margin="40"
                            Background="{DynamicResource MaterialDesignPaper}"
                            CornerRadius="6"
                            Visibility="{Binding IsRoomFeeDrawerOpen, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="20,14" Background="{DynamicResource PrimaryHueMidBrush}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding CloseDrawerCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                    <TextBlock Text="{Binding WorkspaceRoomHeader}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <DockPanel Margin="16">
                                <!-- Fee add/edit form (compact horizontal) -->
                                <GroupBox DockPanel.Dock="Top" Header="{Binding RoomFeeFormMode}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Row 1 -->
                                        <WrapPanel Margin="0,0,0,8">
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Khoản phí"/><ComboBox ItemsSource="{Binding FeeTypes}" SelectedValue="{Binding NewRoomFeeFeeTypeId}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" Width="160"/></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Cách tính"/><ComboBox ItemsSource="{Binding CalculationTypeOptions}" SelectedValue="{Binding NewRoomFeeCalculationType}" SelectedValuePath="Value" DisplayMemberPath="Text" Width="140"/></StackPanel>
                                            <StackPanel Visibility="{Binding RoomFeeUnitPriceVisibility}" Margin="0,0,12,0"><TextBlock Text="Đơn giá"/><TextBox IsEnabled="{Binding RoomFeeCustomPriceInputEnabled}" helpers:MoneyTextBox.Enabled="True" Text="{Binding NewRoomFeeConfig.UnitPrice, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Width="130"/></StackPanel>
                                            <StackPanel Visibility="{Binding RoomFeeFixedAmountVisibility}" Margin="0,0,12,0"><TextBlock Text="Số tiền cố định"/><TextBox IsEnabled="{Binding RoomFeeCustomPriceInputEnabled}" helpers:MoneyTextBox.Enabled="True" Text="{Binding NewRoomFeeConfig.FixedAmount, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Width="130"/></StackPanel>
                                            <StackPanel Visibility="{Binding RoomFeeQuantityVisibility}" Margin="0,0,12,0"><TextBlock Text="Số lượng"/><TextBox Text="{Binding NewRoomFeeConfig.Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100"/></StackPanel>
                                        </WrapPanel>
                                        <!-- Row 2 -->
                                        <WrapPanel VerticalAlignment="Center">
                                            <CheckBox Content="Dùng giá mặc định" IsChecked="{Binding NewRoomFeeUseDefaultPrice}" IsEnabled="{Binding RoomFeeDefaultPriceInputEnabled}" Visibility="{Binding RoomFeeDefaultPriceVisibility}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <CheckBox Content="Đang áp dụng" IsChecked="{Binding NewRoomFeeConfig.Enabled}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Thêm mới" Command="{Binding AddRoomFeeConfigCommand}" Margin="0,0,8,0" Padding="12,0" Height="32"/>
                                                <Button Content="Lưu thay đổi" Command="{Binding SaveRoomFeeConfigCommand}" Margin="0,0,8,0" Padding="12,0" Height="32"/>
                                                <Button Content="Hủy sửa" Command="{Binding CancelRoomFeeConfigEditCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="12,0" Height="32"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </GroupBox>
                                <!-- Applied fees table -->
                                <TextBlock DockPanel.Dock="Top" Text="Khoản phí đang áp dụng" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding WorkspaceRoomFees}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <materialDesign:Card Margin="0,0,0,8" Padding="12,10" materialDesign:ElevationAssist.Elevation="Dp0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Left: Name -->
                                                        <TextBlock Grid.Column="0" Text="{Binding FeeTypeName}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                        <!-- Middle: Type & Price -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding CalculationTypeText}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding AppliedPriceText}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
