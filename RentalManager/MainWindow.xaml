<Window x:Class="RentalManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:RentalManager.Helpers"
        Title="Quản lý nhà trọ" Height="780" Width="1240" MinHeight="680" MinWidth="1040">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,4,2"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10,8,10,2"/>
        </Style>
        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#20242b" Padding="12">
            <DockPanel>
                <TextBlock Text="Quản lý nhà trọ" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Tháng" Foreground="White"/>
                    <ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedBillingMonth}" Width="70"/>
                    <TextBlock Text="Năm" Foreground="White"/>
                    <ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedBillingYear}" Width="90"/>
                    <Button Content="Làm mới" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusMessage}"/>
        </StatusBar>

        <TabControl x:Name="MainTabs">
            <TabItem x:Name="DashboardTab" Header="Tổng quan">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Tổng quan tháng"/>
                    <GroupBox DockPanel.Dock="Top" Header="Bộ lọc">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tháng"/><ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedBillingMonth}" Width="90"/></StackPanel>
                            <StackPanel><TextBlock Text="Năm"/><ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding DashboardYear}" Width="90"/></StackPanel>
                            <StackPanel><TextBlock Text="Khoảng thời gian"/><ComboBox ItemsSource="{Binding DashboardRangeOptions}" SelectedItem="{Binding DashboardRange}" Width="170"/></StackPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding PropertyFilterOptions}" SelectedValue="{Binding DashboardPropertyFilterId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="190"/></StackPanel>
                            <TextBlock Text="{Binding ActiveDashboardPeriod}" FontWeight="SemiBold" Margin="12,18,4,0"/>
                        </WrapPanel>
                    </GroupBox>
                    <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="6" Margin="8">
                        <GroupBox Header="Dự kiến thu"><TextBlock Text="{Binding Dashboard.ExpectedRevenue, StringFormat=N0}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Đã thu"><TextBlock Text="{Binding Dashboard.CollectedAmount, StringFormat=N0}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Chưa thu"><TextBlock Text="{Binding Dashboard.UnpaidAmount, StringFormat=N0}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Phòng đang thuê"><TextBlock Text="{Binding Dashboard.OccupiedRoomCount}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Phòng trống"><TextBlock Text="{Binding Dashboard.VacantRoomCount}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Hóa đơn chưa trả"><TextBlock Text="{Binding Dashboard.UnpaidInvoiceCount}" FontSize="18"/></GroupBox>
                    </UniformGrid>
                    <Border DockPanel.Dock="Top" Margin="10,0,10,4" Padding="8" Background="#fff7df" BorderBrush="#e2bf65" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Có "/>
                            <TextBlock Text="{Binding Dashboard.MissingReadingCount}" FontWeight="SemiBold"/>
                            <TextBlock Text=" phòng thiếu chỉ số điện/nước trong tháng này."/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Hóa đơn trong tháng" Grid.Column="0">
                            <DataGrid ItemsSource="{Binding DashboardInvoices}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tháng" Binding="{Binding BillingMonth}" Width="75"/>
                                    <DataGridTextColumn Header="Nhà" Binding="{Binding PropertyName}" Width="120"/>
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="90"/>
                                    <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                    <DataGridTextColumn Header="Còn lại" Binding="{Binding RemainingAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Header="Thanh toán gần đây" Grid.Column="1">
                            <DataGrid ItemsSource="{Binding DashboardRecentPayments}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ngày" Binding="{Binding PaymentDate, StringFormat=d}" Width="90"/>
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="90"/>
                                    <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                    <DataGridTextColumn Header="Phương thức" Binding="{Binding MethodText}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="RoomsTab" Header="Phòng">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Quản lý phòng"/>
                    <GroupBox DockPanel.Dock="Top" Header="Bộ lọc">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ lọc"/><ComboBox ItemsSource="{Binding PropertyFilterOptions}" SelectedValue="{Binding RoomFilterPropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="170"/></StackPanel>
                            <StackPanel><TextBlock Text="Trạng thái lọc"/><ComboBox ItemsSource="{Binding RoomStatusFilterOptions}" SelectedItem="{Binding RoomFilterStatus}" Width="140"/></StackPanel>
                            <StackPanel><TextBlock Text="Tên phòng"/><TextBox Text="{Binding RoomSearch}" Width="130"/></StackPanel>
                            <StackPanel><TextBlock Text="Người đại diện"/><TextBox Text="{Binding RoomRepresentativeSearch}" Width="140"/></StackPanel>
                            <Button Content="Xóa lọc" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Top" Header="{Binding RoomFormMode}">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding Properties}" SelectedValue="{Binding NewRoom.PropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name"/></StackPanel>
                            <StackPanel><TextBlock Text="Tên phòng"/><TextBox Text="{Binding NewRoom.RoomName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Tầng"/><TextBox Text="{Binding NewRoom.Floor, UpdateSourceTrigger=PropertyChanged}" Width="80"/></StackPanel>
                            <StackPanel><TextBlock Text="Tiền phòng"/><TextBox helpers:MoneyTextBox.Enabled="True" Text="{Binding NewRoom.BaseRent, UpdateSourceTrigger=LostFocus, StringFormat=N0}"/></StackPanel>
                            <StackPanel><TextBlock Text="Trạng thái"/><ComboBox ItemsSource="{Binding RoomFormStatusOptions}" SelectedValue="{Binding NewRoom.Status}" SelectedValuePath="Value" DisplayMemberPath="Text"/></StackPanel>
                            <Button Content="Thêm mới" Command="{Binding AddRoomCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Lưu thay đổi" Command="{Binding SaveRoomCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Hủy sửa" Command="{Binding CancelRoomEditCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Sửa dòng chọn" Command="{Binding EditRoomCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Trả phòng" Command="{Binding DeactivateRoomCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding FilteredRooms}" SelectedItem="{Binding SelectedRoom}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhà / khu trọ" Binding="{Binding PropertyName}" Width="170"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="120"/>
                            <DataGridTextColumn Header="Tầng" Binding="{Binding Floor}" Width="80"/>
                            <DataGridTextColumn Header="Tiền phòng" Binding="{Binding BaseRent, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="120"/>
                            <DataGridTextColumn Header="Người đại diện" Binding="{Binding RepresentativeTenantName}" Width="170"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="130"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="220"/>
                            <DataGridTemplateColumn Header="Hành động" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Sửa" Command="{Binding DataContext.EditRoomRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                            <Button Content="Trả phòng" Command="{Binding DataContext.DeactivateRoomRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="MeterReadingsTab" Header="Chỉ số điện nước">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Nhập chỉ số điện nước"/>
                    <GroupBox DockPanel.Dock="Top" Header="Bộ lọc">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tháng"/><ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding MeterFilterMonth}" Width="80"/></StackPanel>
                            <StackPanel><TextBlock Text="Năm"/><ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding MeterFilterYear}" Width="90"/></StackPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding PropertyFilterOptions}" SelectedValue="{Binding MeterFilterPropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="170"/></StackPanel>
                            <StackPanel><TextBlock Text="Phòng lọc"/><ComboBox ItemsSource="{Binding Rooms}" SelectedValue="{Binding MeterFilterRoomId}" SelectedValuePath="Id" DisplayMemberPath="RoomName" Width="120"/></StackPanel>
                            <StackPanel><TextBlock Text="Loại phí lọc"/><ComboBox ItemsSource="{Binding FeeTypes}" SelectedValue="{Binding MeterFilterFeeTypeId}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" Width="120"/></StackPanel>
                            <Button Content="Xóa lọc" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Top" Header="Nhập chỉ số">
                        <StackPanel>
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding Properties}" SelectedValue="{Binding NewMeterReadingPropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="170"/></StackPanel>
                            <StackPanel><TextBlock Text="Phòng"/><ComboBox ItemsSource="{Binding MeterReadingRoomOptions}" SelectedValue="{Binding NewMeterReadingRoomId}" SelectedValuePath="Id" DisplayMemberPath="RoomName" Width="130"/></StackPanel>
                            <StackPanel><TextBlock Text="Loại phí theo chỉ số"/><ComboBox ItemsSource="{Binding MeterReadingFeeTypeOptions}" SelectedValue="{Binding NewMeterReadingFeeTypeId}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" Width="150"/></StackPanel>
                            <StackPanel><TextBlock Text="Chỉ số cũ"/><TextBox Text="{Binding NewMeterReading.PreviousReading, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Chỉ số mới"/><TextBox Text="{Binding NewMeterReading.CurrentReading, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Ghi chú"/><TextBox Text="{Binding NewMeterReading.Note, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <Button Content="Lưu chỉ số" Command="{Binding AddMeterReadingCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding MeterReadingHelpMessage}" Foreground="#b45309" FontWeight="SemiBold" Margin="6,4,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding FilteredMeterReadings}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tháng" Binding="{Binding BillingMonth}" Width="90"/>
                            <DataGridTextColumn Header="Nhà / khu trọ" Binding="{Binding PropertyName}" Width="150"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="100"/>
                            <DataGridTextColumn Header="Loại phí" Binding="{Binding FeeTypeName}" Width="130"/>
                            <DataGridTextColumn Header="Chỉ số cũ" Binding="{Binding PreviousReading, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="100"/>
                            <DataGridTextColumn Header="Chỉ số mới" Binding="{Binding CurrentReading, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="100"/>
                            <DataGridTextColumn Header="Sử dụng" Binding="{Binding UsageAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="100"/>
                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPriceSnapshot, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="InvoicesTab" Header="Hóa đơn">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Tạo và theo dõi hóa đơn"/>
                    <GroupBox DockPanel.Dock="Top" Header="Sẵn sàng tạo hóa đơn">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Tạo hóa đơn cho phòng đủ dữ liệu" Command="{Binding GenerateReadyInvoicesCommand}" Margin="8"/>
                            <DataGrid ItemsSource="{Binding InvoiceReadinessRows}" Height="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nhà" Binding="{Binding PropertyName}" Width="160"/>
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="120"/>
                                    <DataGridTextColumn Header="Tình trạng" Binding="{Binding StatusText}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Top" Header="Bộ lọc hóa đơn">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tháng"/><ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding InvoiceFilterMonth}" Width="80"/></StackPanel>
                            <StackPanel><TextBlock Text="Năm"/><ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding InvoiceFilterYear}" Width="90"/></StackPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding PropertyFilterOptions}" SelectedValue="{Binding InvoiceFilterPropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="170"/></StackPanel>
                            <StackPanel><TextBlock Text="Phòng lọc"/><ComboBox ItemsSource="{Binding InvoiceFilterRoomOptions}" SelectedValue="{Binding InvoiceFilterRoomId}" SelectedValuePath="Id" DisplayMemberPath="RoomName" Width="120"/></StackPanel>
                            <StackPanel><TextBlock Text="Trạng thái"/><ComboBox ItemsSource="{Binding InvoiceStatusFilterOptions}" SelectedItem="{Binding InvoiceFilterStatus}" Width="140"/></StackPanel>
                            <StackPanel><TextBlock Text="Người đại diện"/><TextBox Text="{Binding InvoiceSearch}" Width="140"/></StackPanel>
                            <Button Content="Xóa lọc" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Top" Header="Thao tác hóa đơn">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#d1d5db" BorderThickness="1" Padding="8" MinWidth="460">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Tạo hóa đơn" FontWeight="SemiBold" Margin="4,0,4,6"/>
                                    <WrapPanel>
                                        <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding Properties}" SelectedValue="{Binding InvoiceNewPropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="170"/></StackPanel>
                                        <StackPanel><TextBlock Text="Phòng"/><ComboBox ItemsSource="{Binding InvoiceFormRoomOptions}" SelectedValue="{Binding InvoiceRoomId}" SelectedValuePath="Id" DisplayMemberPath="RoomName" Width="130"/></StackPanel>
                                        <Button Content="Tạo hóa đơn" Command="{Binding GenerateInvoiceCommand}" VerticalAlignment="Bottom"/>
                                        <Button Content="Tạo tất cả" Command="{Binding GenerateAllInvoicesCommand}" VerticalAlignment="Bottom"/>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#d1d5db" BorderThickness="1" Padding="8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Ghi nhận thanh toán" FontWeight="SemiBold" Margin="4,0,4,6"/>
                                    <WrapPanel>
                                        <TextBlock Text="{Binding SelectedInvoiceSummary}" FontWeight="SemiBold" MinWidth="280" MaxWidth="360" TextWrapping="Wrap" Margin="4,18,8,0"/>
                                        <StackPanel><TextBlock Text="Số tiền"/><TextBox helpers:MoneyTextBox.Enabled="True" Text="{Binding NewPaymentAmount, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Width="130"/></StackPanel>
                                        <StackPanel><TextBlock Text="Phương thức"/><ComboBox ItemsSource="{Binding PaymentMethodOptions}" SelectedValue="{Binding NewPaymentMethod}" SelectedValuePath="Value" DisplayMemberPath="Text" Width="140"/></StackPanel>
                                        <StackPanel><TextBlock Text="Ghi chú"/><TextBox Text="{Binding NewPaymentNote, UpdateSourceTrigger=PropertyChanged}" Width="150"/></StackPanel>
                                        <Button Content="Điền số còn lại" Command="{Binding FillRemainingPaymentCommand}" VerticalAlignment="Bottom"/>
                                        <Button Content="Ghi nhận thanh toán" Command="{Binding RecordPaymentCommand}" VerticalAlignment="Bottom"/>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </GroupBox>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Danh sách hóa đơn">
                            <DataGrid ItemsSource="{Binding FilteredInvoices}" SelectedItem="{Binding SelectedInvoice}" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tháng" Binding="{Binding BillingMonth}" Width="80"/>
                                    <DataGridTextColumn Header="Nhà / khu trọ" Binding="{Binding PropertyName}" Width="150"/>
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="100"/>
                                    <DataGridTextColumn Header="Người đại diện" Binding="{Binding RepresentativeTenantName}" Width="150"/>
                                    <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="115"/>
                                    <DataGridTextColumn Header="Đã thu" Binding="{Binding PaidAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                    <DataGridTextColumn Header="Còn lại" Binding="{Binding RemainingAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="115"/>
                                    <DataGridTemplateColumn Header="Hành động" Width="330">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Chi tiết" Command="{Binding DataContext.SelectInvoiceRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                                    <Button Content="Chốt hóa đơn" Command="{Binding DataContext.IssueInvoiceRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                                    <Button Content="Thanh toán" Command="{Binding DataContext.PayInvoiceRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                                    <Button Content="Sao chép" Command="{Binding DataContext.CopyInvoiceRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                                    <Button Content="Hủy" Command="{Binding DataContext.CancelInvoiceRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <TabControl Grid.Column="1" Margin="4">
                            <TabItem Header="Chi tiết">
                                <DataGrid ItemsSource="{Binding SelectedInvoiceItems}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Khoản" Binding="{Binding ItemName}" Width="140"/>
                                        <DataGridTextColumn Header="SL" Binding="{Binding Quantity, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="60"/>
                                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="90"/>
                                        <DataGridTextColumn Header="Tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Thanh toán">
                                <DataGrid ItemsSource="{Binding SelectedInvoicePayments}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ngày" Binding="{Binding PaymentDate, StringFormat=d}" Width="90"/>
                                        <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="100"/>
                                        <DataGridTextColumn Header="Phương thức" Binding="{Binding MethodText}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="PaymentsTab" Header="Thanh toán">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Lịch sử thanh toán"/>
                    <GroupBox DockPanel.Dock="Top" Header="Tìm kiếm">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tháng"/><ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding PaymentFilterMonth}" Width="80"/></StackPanel>
                            <StackPanel><TextBlock Text="Năm"/><ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding PaymentFilterYear}" Width="90"/></StackPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding PropertyFilterOptions}" SelectedValue="{Binding PaymentFilterPropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="170"/></StackPanel>
                            <StackPanel><TextBlock Text="Phòng"/><ComboBox ItemsSource="{Binding Rooms}" SelectedValue="{Binding PaymentFilterRoomId}" SelectedValuePath="Id" DisplayMemberPath="RoomName" Width="120"/></StackPanel>
                            <StackPanel><TextBlock Text="Phương thức"/><ComboBox ItemsSource="{Binding PaymentMethodFilterOptions}" SelectedItem="{Binding PaymentFilterMethod}" Width="130"/></StackPanel>
                            <StackPanel><TextBlock Text="Người đại diện"/><TextBox Text="{Binding PaymentSearch}" Width="140"/></StackPanel>
                            <Button Content="Xóa lọc" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding FilteredPayments}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày trả" Binding="{Binding PaymentDate, StringFormat=d}" Width="110"/>
                            <DataGridTextColumn Header="Tháng" Binding="{Binding BillingMonth}" Width="90"/>
                            <DataGridTextColumn Header="Nhà / khu trọ" Binding="{Binding PropertyName}" Width="150"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="100"/>
                            <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="120"/>
                            <DataGridTextColumn Header="Phương thức" Binding="{Binding MethodText}" Width="120"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="240"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="TenantsTab" Header="Người thuê">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Quản lý hồ sơ người thuê"/>
                    <GroupBox DockPanel.Dock="Top" Header="Bộ lọc">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tìm kiếm"/><TextBox Text="{Binding TenantSearch, UpdateSourceTrigger=PropertyChanged}" Width="180"/></StackPanel>
                            <StackPanel><TextBlock Text="Trạng thái thuê"/><ComboBox ItemsSource="{Binding TenantStatusFilterOptions}" SelectedItem="{Binding TenantStatusFilter}" Width="150"/></StackPanel>
                            <Button Content="Xóa lọc" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Top" Header="{Binding TenantFormMode}">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Họ tên"/><TextBox Text="{Binding NewTenant.FullName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Số điện thoại"/><TextBox Text="{Binding NewTenant.Phone, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Email"/><TextBox Text="{Binding NewTenant.Email, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="CCCD/CMND"/><TextBox Text="{Binding NewTenant.IdentityNumber, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <Button Content="Thêm mới" Command="{Binding AddTenantCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Lưu thay đổi" Command="{Binding SaveTenantCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Hủy sửa" Command="{Binding CancelTenantEditCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Sửa dòng chọn" Command="{Binding EditTenantCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding FilteredTenants}" SelectedItem="{Binding SelectedTenant}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="180"/>
                            <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" Width="130"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                            <DataGridTextColumn Header="CCCD/CMND" Binding="{Binding IdentityNumber}" Width="140"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="240"/>
                            <DataGridTemplateColumn Header="Hành động" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Sửa" Command="{Binding DataContext.EditTenantRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="AssignmentsTab" Header="Thuê phòng / Phân phòng">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Thuê phòng / Phân phòng"/>
                    <GroupBox DockPanel.Dock="Top" Header="Bộ lọc">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding PropertyFilterOptions}" SelectedValue="{Binding AssignmentFilterPropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="170"/></StackPanel>
                            <StackPanel><TextBlock Text="Phòng"/><ComboBox ItemsSource="{Binding Rooms}" SelectedValue="{Binding AssignmentFilterRoomId}" SelectedValuePath="Id" DisplayMemberPath="RoomName" Width="130"/></StackPanel>
                            <StackPanel><TextBlock Text="Lịch sử"/><ComboBox ItemsSource="{Binding AssignmentHistoryFilterOptions}" SelectedItem="{Binding AssignmentHistoryFilter}" Width="140"/></StackPanel>
                            <Button Content="Xóa lọc" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Top" Header="Gán người thuê vào phòng">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding Properties}" SelectedValue="{Binding AssignmentNewPropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="170"/></StackPanel>
                            <StackPanel><TextBlock Text="Phòng"/><ComboBox ItemsSource="{Binding AssignmentRoomOptions}" SelectedValue="{Binding NewRoomTenant.RoomId}" SelectedValuePath="Id" DisplayMemberPath="DisplayNameWithProperty" Width="190"/></StackPanel>
                            <StackPanel><TextBlock Text="Người thuê"/><ComboBox x:Name="AssignmentTenantComboBox" ItemsSource="{Binding AssignmentTenantOptions}" SelectedItem="{Binding SelectedAssignmentTenant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="AssignmentDisplayText" TextSearch.TextPath="AssignmentDisplayText" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" Width="230" Loaded="AssignmentTenantComboBox_Loaded" GotKeyboardFocus="AssignmentTenantComboBox_GotKeyboardFocus" PreviewMouseDown="AssignmentTenantComboBox_PreviewMouseDown" SelectionChanged="AssignmentTenantComboBox_SelectionChanged"/></StackPanel>
                            <StackPanel><TextBlock Text="Ngày bắt đầu"/><DatePicker SelectedDate="{Binding NewRoomTenant.StartDate}" Width="130"/></StackPanel>
                            <CheckBox Content="Người đại diện" IsChecked="{Binding NewRoomTenant.IsRepresentative}" VerticalAlignment="Bottom" Margin="8"/>
                            <Button Content="Gán vào phòng" Command="{Binding AssignTenantCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Top" Header="Thao tác chuyển / kết thúc thuê">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Ngày kết thúc"/><DatePicker SelectedDate="{Binding AssignmentEndDate}" Width="130"/></StackPanel>
                            <TextBlock Text="Dùng nút Kết thúc thuê hoặc Chuyển phòng trực tiếp trên dòng đang thuê." Margin="12,18,4,0" FontStyle="Italic"/>
                        </WrapPanel>
                    </GroupBox>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <GroupBox Header="Đang thuê" Grid.Row="0">
                            <DataGrid ItemsSource="{Binding ActiveRoomTenants}" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nhà / khu trọ" Binding="{Binding PropertyName}" Width="150"/>
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="110"/>
                                    <DataGridTextColumn Header="Người thuê" Binding="{Binding TenantName}" Width="170"/>
                                    <DataGridTextColumn Header="Vai trò" Binding="{Binding RepresentativeText}" Width="110"/>
                                    <DataGridTextColumn Header="Ngày bắt đầu" Binding="{Binding StartDate, StringFormat=d}" Width="110"/>
                                    <DataGridTemplateColumn Header="Hành động" Width="300">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Đặt đại diện" Command="{Binding DataContext.SetRepresentativeRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                                    <Button Content="Kết thúc thuê" Command="{Binding DataContext.EndAssignmentRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                                    <Button Content="Chuyển phòng" Command="{Binding DataContext.ChangeRoomRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Header="Lịch sử thuê" Grid.Row="1">
                            <DataGrid ItemsSource="{Binding FilteredAssignmentHistory}" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nhà / khu trọ" Binding="{Binding PropertyName}" Width="150"/>
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="110"/>
                                    <DataGridTextColumn Header="Người thuê" Binding="{Binding TenantName}" Width="170"/>
                                    <DataGridTextColumn Header="Vai trò" Binding="{Binding RepresentativeText}" Width="110"/>
                                    <DataGridTextColumn Header="Ngày bắt đầu" Binding="{Binding StartDate, StringFormat=d}" Width="110"/>
                                    <DataGridTextColumn Header="Ngày kết thúc" Binding="{Binding EndDate, StringFormat=d}" Width="110"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="RoomFeesTab" Header="Phí theo phòng">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Phí theo phòng"/>
                    <GroupBox DockPanel.Dock="Top" Header="Bộ lọc">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tìm kiếm"/><TextBox Text="{Binding RoomFeeSearch, UpdateSourceTrigger=PropertyChanged}" Width="160"/></StackPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding Properties}" SelectedValue="{Binding RoomFeePropertyFilterId}" SelectedValuePath="Id" DisplayMemberPath="Name"/></StackPanel>
                            <StackPanel><TextBlock Text="Phòng"/><ComboBox ItemsSource="{Binding RoomFeeFilterRoomOptions}" SelectedValue="{Binding RoomFeeRoomFilterId}" SelectedValuePath="Id" DisplayMemberPath="DisplayNameWithProperty" Width="190"/></StackPanel>
                            <StackPanel><TextBlock Text="Loại phí"/><ComboBox ItemsSource="{Binding FeeTypes}" SelectedValue="{Binding RoomFeeFeeTypeFilterId}" SelectedValuePath="Id" DisplayMemberPath="DisplayName"/></StackPanel>
                            <StackPanel><TextBlock Text="Trạng thái áp dụng"/><ComboBox ItemsSource="{Binding RoomFeeStatusFilterOptions}" SelectedItem="{Binding RoomFeeStatusFilter}" Width="140"/></StackPanel>
                            <Button Content="Xóa lọc" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Top" Header="{Binding RoomFeeFormMode}">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding Properties}" SelectedValue="{Binding NewRoomFeePropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="170"/></StackPanel>
                            <StackPanel><TextBlock Text="Phòng"/><ComboBox ItemsSource="{Binding RoomFeeFormRoomOptions}" SelectedValue="{Binding NewRoomFeeConfig.RoomId}" SelectedValuePath="Id" DisplayMemberPath="DisplayNameWithProperty" Width="190"/></StackPanel>
                            <StackPanel><TextBlock Text="Loại phí"/><ComboBox ItemsSource="{Binding FeeTypes}" SelectedValue="{Binding NewRoomFeeFeeTypeId}" SelectedValuePath="Id" DisplayMemberPath="DisplayName"/></StackPanel>
                            <StackPanel><TextBlock Text="Cách tính"/><ComboBox ItemsSource="{Binding CalculationTypeOptions}" SelectedValue="{Binding NewRoomFeeCalculationType}" SelectedValuePath="Value" DisplayMemberPath="Text"/></StackPanel>
                            <CheckBox Content="Dùng giá mặc định" IsChecked="{Binding NewRoomFeeUseDefaultPrice}" IsEnabled="{Binding RoomFeeDefaultPriceInputEnabled}" Visibility="{Binding RoomFeeDefaultPriceVisibility}" VerticalAlignment="Bottom" Margin="8"/>
                            <StackPanel Visibility="{Binding RoomFeeUnitPriceVisibility}"><TextBlock Text="Đơn giá"/><TextBox IsEnabled="{Binding RoomFeeCustomPriceInputEnabled}" helpers:MoneyTextBox.Enabled="True" Text="{Binding NewRoomFeeConfig.UnitPrice, UpdateSourceTrigger=LostFocus, StringFormat=N0}"/></StackPanel>
                            <StackPanel Visibility="{Binding RoomFeeFixedAmountVisibility}"><TextBlock Text="Cố định"/><TextBox IsEnabled="{Binding RoomFeeCustomPriceInputEnabled}" helpers:MoneyTextBox.Enabled="True" Text="{Binding NewRoomFeeConfig.FixedAmount, UpdateSourceTrigger=LostFocus, StringFormat=N0}"/></StackPanel>
                            <StackPanel Visibility="{Binding RoomFeeQuantityVisibility}"><TextBlock Text="Số lượng"/><TextBox Text="{Binding NewRoomFeeConfig.Quantity, UpdateSourceTrigger=PropertyChanged}" Width="90"/></StackPanel>
                            <CheckBox Content="Đang áp dụng" IsChecked="{Binding NewRoomFeeConfig.Enabled}" VerticalAlignment="Bottom" Margin="8"/>
                            <Button Content="Thêm mới" Command="{Binding AddRoomFeeConfigCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Sửa dòng chọn" Command="{Binding EditRoomFeeConfigCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Lưu thay đổi" Command="{Binding SaveRoomFeeConfigCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Hủy sửa" Command="{Binding CancelRoomFeeConfigEditCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="{Binding SelectedRoomFeeToggleActionText}" Command="{Binding DisableRoomFeeConfigCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding FilteredRoomFeeConfigs}" SelectedItem="{Binding SelectedRoomFeeConfig}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomDisplayNameWithProperty}" Width="190"/>
                            <DataGridTextColumn Header="Loại phí" Binding="{Binding FeeTypeName}" Width="120"/>
                            <DataGridTextColumn Header="Cách tính" Binding="{Binding CalculationTypeText}" Width="105"/>
                            <DataGridTextColumn Header="Giá áp dụng" Binding="{Binding AppliedPriceText}" Width="125"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding EnabledText}" Width="110"/>
                            <DataGridTemplateColumn Header="Hành động" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Sửa" Command="{Binding DataContext.EditRoomFeeRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                            <Button Content="{Binding ToggleActionText}" Command="{Binding DataContext.DisableRoomFeeRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="FeeTypesTab" Header="Loại phí">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Loại phí"/>
                    <GroupBox DockPanel.Dock="Top" Header="{Binding FeeTypeFormMode}">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tên loại phí"/><TextBox Text="{Binding NewFeeType.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Cách tính"/><ComboBox ItemsSource="{Binding CalculationTypeOptions}" SelectedValue="{Binding NewFeeType.DefaultCalculationType}" SelectedValuePath="Value" DisplayMemberPath="Text"/></StackPanel>
                            <StackPanel><TextBlock Text="Đơn vị"/><TextBox Text="{Binding NewFeeType.DefaultUnit, UpdateSourceTrigger=PropertyChanged}" Width="100"/></StackPanel>
                            <StackPanel><TextBlock Text="Đơn giá mặc định"/><TextBox helpers:MoneyTextBox.Enabled="True" Text="{Binding NewFeeType.DefaultUnitPrice, UpdateSourceTrigger=LostFocus, StringFormat=N0}"/></StackPanel>
                            <Button Content="Thêm mới" Command="{Binding AddFeeTypeCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Sửa dòng chọn" Command="{Binding EditFeeTypeCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Lưu thay đổi" Command="{Binding SaveFeeTypeCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Hủy sửa" Command="{Binding CancelFeeTypeEditCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="{Binding SelectedFeeTypeToggleActionText}" Command="{Binding DeactivateFeeTypeCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding FeeTypes}" SelectedItem="{Binding SelectedFeeType}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên phí" Binding="{Binding DisplayName}" Width="160"/>
                            <DataGridTextColumn Header="Cách tính" Binding="{Binding CalculationTypeText}" Width="130"/>
                            <DataGridTextColumn Header="Đơn vị" Binding="{Binding DefaultUnit}" Width="100"/>
                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding DefaultUnitPrice, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="120"/>
                            <DataGridTextColumn Header="Loại hệ thống" Binding="{Binding SystemStatusText}" Width="110"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding ActiveStatusText}" Width="110"/>
                            <DataGridTemplateColumn Header="Hành động" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Sửa" Command="{Binding DataContext.EditFeeTypeRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                            <Button Content="{Binding ToggleActionText}" Command="{Binding DataContext.DeactivateFeeTypeRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="PropertiesTab" Header="Nhà / Khu trọ">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Nhà / khu trọ"/>
                    <GroupBox DockPanel.Dock="Top" Header="{Binding PropertyFormMode}">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tên nhà / khu trọ"/><TextBox Text="{Binding NewProperty.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Địa chỉ"/><TextBox Text="{Binding NewProperty.Address, UpdateSourceTrigger=PropertyChanged}" MinWidth="240"/></StackPanel>
                            <StackPanel><TextBlock Text="Ghi chú"/><TextBox Text="{Binding NewProperty.Note, UpdateSourceTrigger=PropertyChanged}" MinWidth="240"/></StackPanel>
                            <Button Content="Thêm mới" Command="{Binding AddPropertyCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Lưu thay đổi" Command="{Binding SavePropertyCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Hủy sửa" Command="{Binding CancelPropertyEditCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Sửa dòng chọn" Command="{Binding EditPropertyCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Ngừng sử dụng" Command="{Binding DeactivatePropertyCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding Properties}" SelectedItem="{Binding SelectedProperty}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên nhà / khu trọ" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" Width="260"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="220"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding ActiveStatusText}" Width="130"/>
                            <DataGridTemplateColumn Header="Hành động" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Sửa" Command="{Binding DataContext.EditPropertyRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                            <Button Content="Ngừng" Command="{Binding DataContext.DeactivatePropertyRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="Cài đặt">
                <StackPanel Margin="16">
                    <TextBlock Text="Vị trí file dữ liệu" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" MinWidth="720"/>
                    <Button Content="Sao lưu ra Desktop\RentalManagerBackups" Width="280" HorizontalAlignment="Left" Command="{Binding BackupCommand}"/>
                    <Button Content="Khôi phục từ bản sao lưu" Width="280" HorizontalAlignment="Left" Command="{Binding RestoreCommand}"/>
                    <Button Content="Tạo dữ liệu mẫu" Width="280" HorizontalAlignment="Left" Command="{Binding SeedDemoDataCommand}"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
