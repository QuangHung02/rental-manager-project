<Window x:Class="RentalManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:RentalManager.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Quản lý nhà trọ" Icon="Assets/appicon.ico" Height="720" Width="1100" MinHeight="560" MinWidth="900">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,4,2"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline5TextBlock}">
            <Setter Property="Margin" Value="10,8,10,2"/>
        </Style>
        <Style x:Key="PageHeaderBorder" TargetType="Border">
            <Setter Property="Padding" Value="0,0,0,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
        </Style>
        <Style x:Key="PrimaryAddButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PropertyActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="DestructivePropertyActionButton" TargetType="Button" BasedOn="{StaticResource PropertyActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
        </Style>
        <Style x:Key="FilterPanel" TargetType="GroupBox" BasedOn="{StaticResource MaterialDesignCardGroupBox}">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="PropertySelectorListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MaxHeight" Value="132"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="PropertySelectorItem" TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueLightForegroundBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHueLightForegroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueDarkBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RightCell" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style x:Key="TopBarComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="GroupBox" BasedOn="{StaticResource MaterialDesignCardGroupBox}">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="SectionCardHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <Style x:Key="SectionCardHeaderText" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueLightForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryMid" Padding="16">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="HomeCity" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Quản lý nhà trọ" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Tháng" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="White"/>
                    <ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedBillingMonth}" Width="70" Foreground="White" materialDesign:HintAssist.Foreground="White" ItemContainerStyle="{StaticResource TopBarComboBoxItemStyle}"/>
                    <TextBlock Text="Năm" VerticalAlignment="Center" Margin="16,0,4,0" Foreground="White"/>
                    <ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedBillingYear}" Width="90" Foreground="White" materialDesign:HintAssist.Foreground="White" ItemContainerStyle="{StaticResource TopBarComboBoxItemStyle}"/>
                    <Button Content="Làm mới" Command="{Binding RefreshCommand}" Margin="16,0,0,0" Style="{StaticResource MaterialDesignOutlinedLightButton}"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource MaterialDesignPaper}">
            <StatusBarItem Content="{Binding StatusMessage}"/>
        </StatusBar>

                <TabControl x:Name="MainTabs" TabStripPlacement="Left" Margin="0,4,0,0" SelectionChanged="TabControl_SelectionChanged">
            <TabItem x:Name="DashboardTab" Header="Tổng quan">
                <TabControl TabStripPlacement="Top" SelectionChanged="TabControl_SelectionChanged">
                    <TabItem Header="Tổng quan tháng">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <DockPanel x:Name="MonthlyOverviewContent" Margin="8" SizeChanged="MonthlyOverviewContent_SizeChanged">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Tổng quan tháng"/>
                            <GroupBox DockPanel.Dock="Top" Header="Bộ lọc">
                                <WrapPanel>
                                    <StackPanel><TextBlock Text="Tháng"/><ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedBillingMonth}" Width="90"/></StackPanel>
                                    <StackPanel><TextBlock Text="Năm"/><ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding DashboardYear}" Width="90"/></StackPanel>
                                    <StackPanel><TextBlock Text="Khoảng thời gian"/><ComboBox ItemsSource="{Binding DashboardRangeOptions}" SelectedItem="{Binding DashboardRange}" Width="170"/></StackPanel>
                                    <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding PropertyFilterOptions}" SelectedValue="{Binding DashboardPropertyFilterId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="190"/></StackPanel>
                                    <TextBlock Text="{Binding ActiveDashboardPeriod}" FontWeight="SemiBold" Margin="12,18,4,0"/>
                                </WrapPanel>
                            </GroupBox>
                            <WrapPanel DockPanel.Dock="Top" Margin="8">
                                <GroupBox Header="Dự kiến thu" Width="170"><TextBlock Text="{Binding Dashboard.ExpectedRevenue, StringFormat=N0}" FontSize="18"/></GroupBox>
                                <GroupBox Header="Đã thu" Width="170"><TextBlock Text="{Binding Dashboard.CollectedAmount, StringFormat=N0}" FontSize="18"/></GroupBox>
                                <GroupBox Header="Chưa thu" Width="170"><TextBlock Text="{Binding Dashboard.UnpaidAmount, StringFormat=N0}" FontSize="18"/></GroupBox>
                                <GroupBox Header="Phòng đang thuê" Width="170"><TextBlock Text="{Binding Dashboard.OccupiedRoomCount}" FontSize="18"/></GroupBox>
                                <GroupBox Header="Phòng trống" Width="170"><TextBlock Text="{Binding Dashboard.VacantRoomCount}" FontSize="18"/></GroupBox>
                                <GroupBox Header="Hóa đơn còn nợ" Width="170"><TextBlock Text="{Binding Dashboard.UnpaidInvoiceCount}" FontSize="18"/></GroupBox>
                            </WrapPanel>
                            <Border DockPanel.Dock="Top" Margin="10,0,10,4" Padding="8" Background="#fff7df" BorderBrush="#e2bf65" BorderThickness="1">
                                <WrapPanel>
                                    <TextBlock Text="Có "/>
                                    <TextBlock Text="{Binding Dashboard.MissingReadingCount}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" phòng thiếu chỉ số điện/nước trong tháng đang chọn."/>
                                </WrapPanel>
                            </Border>
                            <Grid x:Name="MonthlyOverviewTablesGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="MonthlyOverviewTablesFirstRow" Height="Auto"/>
                                    <RowDefinition x:Name="MonthlyOverviewTablesSecondRow" Height="0"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="MonthlyOverviewTablesFirstColumn"/>
                                    <ColumnDefinition x:Name="MonthlyOverviewTablesSecondColumn"/>
                                </Grid.ColumnDefinitions>
                                <GroupBox x:Name="DashboardInvoicesGroup" Header="Trạng thái hóa đơn trong tháng" Grid.Row="0" Grid.Column="0">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <TextBlock Text="Chọn một hóa đơn rồi bấm Ghi nhận thanh toán." VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <Button Content="Ghi nhận thanh toán" Command="{Binding OpenPaymentDrawerCommand}" Click="DashboardPaymentButton_Click" Margin="12,0,0,0" Padding="10,0"/>
                                        </WrapPanel>
                                        <DataGrid ItemsSource="{Binding DashboardInvoices}" SelectedItem="{Binding SelectedInvoice}" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Tháng" Binding="{Binding BillingMonth}" Width="75"/>
                                                <DataGridTextColumn Header="Nhà" Binding="{Binding PropertyName}" Width="120"/>
                                                <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="90"/>
                                                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                                <DataGridTextColumn Header="Còn lại" Binding="{Binding RemainingAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="110"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </GroupBox>
                                <GroupBox x:Name="DashboardPaymentsGroup" Header="Lịch sử thanh toán" Grid.Row="0" Grid.Column="1">
                                    <DataGrid ItemsSource="{Binding DashboardRecentPayments}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Ngày" Binding="{Binding PaymentDate, StringFormat=d}" Width="90"/>
                                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="90"/>
                                            <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                            <DataGridTextColumn Header="Phương thức" Binding="{Binding MethodText}" Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                            </Grid>
                        </DockPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Tổng quan năm">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Tổng quan năm"/>
                            <GroupBox DockPanel.Dock="Top" Header="Bộ lọc">
                                <WrapPanel>
                                    <StackPanel><TextBlock Text="Năm"/><ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding DashboardYear}" Width="90"/></StackPanel>
                                    <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding PropertyFilterOptions}" SelectedValue="{Binding DashboardPropertyFilterId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="190"/></StackPanel>
                                </WrapPanel>
                            </GroupBox>
                            <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="4" Margin="8">
                                <GroupBox Header="Dự kiến thu năm"><TextBlock Text="{Binding YearlyDashboard.ExpectedRevenue, StringFormat=N0}" FontSize="18"/></GroupBox>
                                <GroupBox Header="Đã thu năm"><TextBlock Text="{Binding YearlyDashboard.CollectedAmount, StringFormat=N0}" FontSize="18"/></GroupBox>
                                <GroupBox Header="Chưa thu năm"><TextBlock Text="{Binding YearlyDashboard.UnpaidAmount, StringFormat=N0}" FontSize="18"/></GroupBox>
                                <GroupBox Header="Hóa đơn còn nợ"><TextBlock Text="{Binding YearlyDashboard.UnpaidInvoiceCount}" FontSize="18"/></GroupBox>
                            </UniformGrid>
                            <GroupBox Header="Tổng hợp theo tháng">
                                <DataGrid ItemsSource="{Binding DashboardMonthlySummaries}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tháng" Binding="{Binding BillingMonth}" Width="90"/>
                                        <DataGridTextColumn Header="Dự kiến thu" Binding="{Binding ExpectedRevenue, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="130"/>
                                        <DataGridTextColumn Header="Đã thu" Binding="{Binding CollectedAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="130"/>
                                        <DataGridTextColumn Header="Chưa thu" Binding="{Binding UnpaidAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="130"/>
                                        <DataGridTextColumn Header="Hóa đơn còn nợ" Binding="{Binding UnpaidInvoiceCount}" ElementStyle="{StaticResource RightCell}" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </TabItem>
                                                <TabItem Header="Nhà &amp; Phòng">
                <!-- Internal toggle: Quản lý phòng | Danh mục khoản phí -->
                <TabControl TabStripPlacement="Top" SelectionChanged="TabControl_SelectionChanged">
                    <TabItem Header="Quản lý phòng">
                        <Grid>
                    <!-- ── MAIN CONTENT ── -->
                    <DockPanel Panel.ZIndex="1">
                        <!-- Top action bar -->
                        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <DockPanel>
                                <TextBlock Text="Nhà &amp; Phòng" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+ Thêm phòng" Command="{Binding OpenAddRoomDrawerCommand}" Style="{StaticResource PrimaryAddButton}" Margin="0,0,8,0"/>
                                    <Button Content="+ Thêm nhà" Command="{Binding OpenAddPropertyDrawerCommand}" Style="{StaticResource PrimaryAddButton}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- Property selector strip -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryHueLightBrush}" Padding="8,4">
                            <ListBox ItemsSource="{Binding Properties}" SelectedItem="{Binding SelectedProperty}"
                                     Style="{StaticResource PropertySelectorListBox}"
                                     ItemContainerStyle="{StaticResource PropertySelectorItem}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border DockPanel.Dock="Top" Padding="16,8" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <DockPanel>
                                <TextBlock Text="{Binding WorkspacePropertyHeader}" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Opacity="0.8"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Sửa nhà" Command="{Binding OpenEditPropertyDrawerCommand}"
                                            CommandParameter="{Binding SelectedProperty}"
                                            Style="{StaticResource PropertyActionButton}" Margin="0,0,8,0"/>
                                    <Button Content="Xóa nhà" Command="{Binding DeletePropertyCommand}"
                                            Style="{StaticResource DestructivePropertyActionButton}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- Room cards -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,12,16,16">
                                <TextBlock Text="Chọn nhà để xem danh sách phòng. Bấm ‘Khoản phí’ trên từng phòng để thêm hoặc quản lý điện, nước, wifi, rác và các phí khác."
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding WorkspaceRooms}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <materialDesign:Card Margin="6" Width="290" Padding="0" materialDesign:ElevationAssist.Elevation="Dp2">
                                                <DockPanel>
                                                    <!-- Status bar at top of card -->
                                                    <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryHueLightBrush}" Padding="12,4">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding RoomName}" FontWeight="Bold" FontSize="15"
                                                                       Foreground="{DynamicResource PrimaryHueLightForegroundBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                       Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85"/>
                                                        </DockPanel>
                                                    </Border>
                                                    <!-- Card body -->
                                                    <StackPanel Margin="12,10,12,12">
                                                        <TextBlock Text="{Binding BaseRent, StringFormat='{}{0:N0} ₫'}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                            <materialDesign:PackIcon Kind="AccountCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Opacity="0.55" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding RepresentativeTenantName}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                            <materialDesign:PackIcon Kind="Stairs" Width="14" Height="14" VerticalAlignment="Center" Opacity="0.45" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding Floor, StringFormat='Tầng {0}'}" FontSize="11" Opacity="0.55"/>
                                                        </StackPanel>
                                                        <!-- Action buttons -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Sửa" Margin="0,0,4,0" Height="30" FontSize="12" Padding="8,0"
                                                                    Command="{Binding DataContext.OpenEditRoomDrawerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                            <Button Content="Khoản phí" Margin="0,0,4,0" Height="30" FontSize="12" Padding="8,0"
                                                                    Command="{Binding DataContext.OpenRoomFeeDrawerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                            <Button Content="Trả phòng" Margin="0,0,0,0" Height="30" FontSize="12" Padding="8,0"
                                                                    Command="{Binding DataContext.DeactivateRoomRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </materialDesign:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- ── OVERLAY DIMMER ── -->
                    <Border Panel.ZIndex="50" Background="#70000000"
                            Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDrawerCommand}"/>
                        </Border.InputBindings>
                    </Border>

                    <!-- ── PROPERTY MODAL (centered) ── -->
                    <Border Panel.ZIndex="51"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            MaxWidth="500" Margin="24"
                            Background="{DynamicResource MaterialDesignPaper}"
                            CornerRadius="6"
                            Visibility="{Binding IsPropertyDrawerOpen, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="20,14" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="6,6,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding CloseDrawerCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}" Focusable="False"
                                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                    <TextBlock Text="{Binding PropertyFormMode}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20,16,20,20">
                                <TextBlock Text="Tên nhà / khu trọ" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewProperty.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <TextBlock Text="Địa chỉ" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewProperty.Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                <TextBlock Text="Ghi chú" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewProperty.Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Ngừng sử dụng" Command="{Binding DeactivatePropertyCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0" Foreground="{DynamicResource ErrorBrush}" BorderBrush="{DynamicResource ErrorBrush}"/>
                                    <Button Content="Thêm mới" Command="{Binding AddPropertyCommand}" Margin="0,0,8,0" Padding="12,0"/>
                                    <Button Content="Lưu thay đổi" Command="{Binding SavePropertyCommand}" Margin="0,0,8,0" Padding="12,0"/>
                                    <Button Content="Hủy sửa" Command="{Binding CancelPropertyEditCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="12,0"/>
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- ── ROOM MODAL (centered) ── -->
                    <Border Panel.ZIndex="51"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            MaxWidth="540" Margin="24"
                            Background="{DynamicResource MaterialDesignPaper}"
                            CornerRadius="6"
                            Visibility="{Binding IsRoomDrawerOpen, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="20,14" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="6,6,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding CloseDrawerCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}" Focusable="False"
                                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                    <TextBlock Text="{Binding RoomFormMode}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20,16,20,20">
                                <WrapPanel Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,16,0" Width="240">
                                        <TextBlock Text="Nhà / khu trọ" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding Properties}" SelectedValue="{Binding NewRoom.PropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name"/>
                                    </StackPanel>
                                    <StackPanel Width="240">
                                        <TextBlock Text="Tầng" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewRoom.Floor, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </WrapPanel>
                                
                                <TextBlock Text="Tên phòng" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewRoom.RoomName, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="Có thể nhập một phòng hoặc nhiều phòng, phân tách bằng dấu phẩy, chấm phẩy hoặc xuống dòng. Ví dụ: 1.01, 1.02, 1.03" FontSize="11" Opacity="0.6" Margin="0,4,0,14" TextWrapping="Wrap"/>
                                
                                <WrapPanel Margin="0,0,0,20">
                                    <StackPanel Margin="0,0,16,0" Width="240">
                                        <TextBlock Text="Giá thuê mặc định (₫)" Margin="0,0,0,4"/>
                                        <TextBox helpers:MoneyTextBox.Enabled="True" Text="{Binding NewRoom.BaseRent, UpdateSourceTrigger=LostFocus, StringFormat=N0}"/>
                                    </StackPanel>
                                    <StackPanel Width="240">
                                        <TextBlock Text="Trạng thái" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding RoomFormStatusOptions}" SelectedValue="{Binding NewRoom.Status}" SelectedValuePath="Value" DisplayMemberPath="Text"/>
                                    </StackPanel>
                                </WrapPanel>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Trả phòng" Command="{Binding DeactivateRoomCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0" Visibility="{Binding NewRoom.IsOccupied, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Thêm mới" Command="{Binding AddRoomCommand}" Margin="0,0,8,0" Padding="12,0"/>
                                    <Button Content="Lưu thay đổi" Command="{Binding SaveRoomCommand}" Margin="0,0,8,0" Padding="12,0"/>
                                    <Button Content="Hủy sửa" Command="{Binding CancelRoomEditCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="12,0"/>
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- ── ROOM FEE MODAL (centered) ── -->
                    <Border Panel.ZIndex="51"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="860" MaxHeight="680"
                            Width="Auto" MinWidth="0"
                            Margin="24"
                            Background="{DynamicResource MaterialDesignPaper}"
                            CornerRadius="6"
                            Visibility="{Binding IsRoomFeeDrawerOpen, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="20,14" Background="{DynamicResource PrimaryHueMidBrush}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding CloseDrawerCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Foreground="{DynamicResource PrimaryHueMidForegroundBrush}">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                    <TextBlock Text="{Binding WorkspaceRoomHeader}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <DockPanel Margin="16">
                                <!-- Fee add/edit form (compact horizontal) -->
                                <GroupBox DockPanel.Dock="Top" Header="{Binding RoomFeeFormMode}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Row 1 -->
                                        <WrapPanel Margin="0,0,0,8">
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Khoản phí"/><ComboBox ItemsSource="{Binding FeeTypes}" SelectedValue="{Binding NewRoomFeeFeeTypeId}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" Width="160"/></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Cách tính"/><ComboBox ItemsSource="{Binding CalculationTypeOptions}" SelectedValue="{Binding NewRoomFeeCalculationType}" SelectedValuePath="Value" DisplayMemberPath="Text" Width="140"/></StackPanel>
                                            <StackPanel Visibility="{Binding RoomFeeUnitPriceVisibility}" Margin="0,0,12,0"><TextBlock Text="Đơn giá"/><TextBox IsEnabled="{Binding RoomFeeCustomPriceInputEnabled}" helpers:MoneyTextBox.Enabled="True" Text="{Binding NewRoomFeeConfig.UnitPrice, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Width="130"/></StackPanel>
                                            <StackPanel Visibility="{Binding RoomFeeFixedAmountVisibility}" Margin="0,0,12,0"><TextBlock Text="Số tiền cố định"/><TextBox IsEnabled="{Binding RoomFeeCustomPriceInputEnabled}" helpers:MoneyTextBox.Enabled="True" Text="{Binding NewRoomFeeConfig.FixedAmount, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Width="130"/></StackPanel>
                                            <StackPanel Visibility="{Binding RoomFeeQuantityVisibility}" Margin="0,0,12,0"><TextBlock Text="Số lượng"/><TextBox Text="{Binding NewRoomFeeConfig.Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100"/></StackPanel>
                                        </WrapPanel>
                                        <!-- Row 2 -->
                                        <WrapPanel VerticalAlignment="Center">
                                            <CheckBox Content="Dùng giá mặc định" IsChecked="{Binding NewRoomFeeUseDefaultPrice}" IsEnabled="{Binding RoomFeeDefaultPriceInputEnabled}" Visibility="{Binding RoomFeeDefaultPriceVisibility}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <CheckBox Content="Đang áp dụng" IsChecked="{Binding NewRoomFeeConfig.Enabled}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Thêm mới" Command="{Binding AddRoomFeeConfigCommand}" Margin="0,0,8,0" Padding="12,0" Height="32"/>
                                                <Button Content="Lưu thay đổi" Command="{Binding SaveRoomFeeConfigCommand}" Margin="0,0,8,0" Padding="12,0" Height="32"/>
                                                <Button Content="Hủy sửa" Command="{Binding CancelRoomFeeConfigEditCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="12,0" Height="32"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </GroupBox>
                                <!-- Applied fees table -->
                                <TextBlock DockPanel.Dock="Top" Text="Khoản phí đang áp dụng" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding WorkspaceRoomFees}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <materialDesign:Card Margin="0,0,0,8" Padding="12,10" materialDesign:ElevationAssist.Elevation="Dp0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Left: Name -->
                                                        <TextBlock Grid.Column="0" Text="{Binding FeeTypeName}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                        <!-- Middle: Type & Price -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding CalculationTypeText}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding AppliedPriceText}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                        </StackPanel>
                                                        <!-- Right: Status & Actions -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Border Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="4" Padding="6,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding EnabledText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"/>
                                                            </Border>
                                                            <Button Content="Sửa" Command="{Binding DataContext.EditRoomFeeRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="12,4" Height="30" Margin="0,0,8,0"/>
                                                            <Button Content="{Binding ToggleActionText}" Command="{Binding DataContext.DisableRoomFeeRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="12,4" Height="30"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </materialDesign:Card>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </Grid>
                    </TabItem>
                    <TabItem Header="Danh mục khoản phí">
                        <Grid>
                            <DockPanel Margin="16,12,16,16">
                                <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderBorder}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" Text="Danh mục khoản phí"/>
                                            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                                       Text="Quản lý các loại phí toàn cục: Điện, Nước, Wifi, Rác, Giữ xe và các khoản phí khác. Sau khi thêm khoản phí, mở thẻ ‘Quản lý phòng’ và bấm ‘Khoản phí’ trên từng phòng để áp dụng."/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="+ Thêm khoản phí"
                                                Command="{Binding OpenAddFeeTypeDrawerCommand}"
                                                Style="{StaticResource PrimaryAddButton}"
                                                HorizontalAlignment="Right" Margin="16,0,0,0"/>
                                    </Grid>
                                </Border>
                                <DataGrid ItemsSource="{Binding FeeTypes}" SelectedItem="{Binding SelectedFeeType}" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên khoản phí" Binding="{Binding DisplayName}" Width="160"/>
                                    <DataGridTextColumn Header="Cách tính" Binding="{Binding CalculationTypeText}" Width="130"/>
                                    <DataGridTextColumn Header="Đơn vị" Binding="{Binding DefaultUnit}" Width="100"/>
                                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding DefaultUnitPrice, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="120"/>
                                    <DataGridTextColumn Header="Loại" Binding="{Binding SystemStatusText}" Width="110"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding ActiveStatusText}" Width="110"/>
                                    <DataGridTemplateColumn Header="Hành động" Width="SizeToCells">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Sửa" Command="{Binding DataContext.EditFeeTypeRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="8,0" Margin="0,0,6,0"/>
                                                    <Button Content="{Binding ToggleActionText}" Command="{Binding DataContext.DeactivateFeeTypeRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="8,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            </DockPanel>

                            <Border Panel.ZIndex="50" Background="#70000000"
                                    Visibility="{Binding IsFeeTypeDrawerOpen, Converter={StaticResource BoolToVis}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseFeeTypeDrawerCommand}"/>
                                </Border.InputBindings>
                            </Border>
                            <Border Panel.ZIndex="51" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    MaxWidth="540" MaxHeight="520" Margin="24"
                                    Background="{DynamicResource MaterialDesignPaper}" CornerRadius="6"
                                    Visibility="{Binding IsFeeTypeDrawerOpen, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Padding="20,14" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="6,6,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Command="{Binding CloseFeeTypeDrawerCommand}"
                                                    Style="{StaticResource MaterialDesignIconButton}" Focusable="False"
                                                    Foreground="{DynamicResource PrimaryHueMidForegroundBrush}">
                                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                            </Button>
                                            <TextBlock Text="{Binding FeeTypeFormMode}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="20,16,20,20">
                                            <TextBlock Text="Tên khoản phí" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding NewFeeType.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                            <TextBlock Text="Cách tính" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding CalculationTypeOptions}"
                                                      SelectedValue="{Binding NewFeeType.DefaultCalculationType}"
                                                      SelectedValuePath="Value" DisplayMemberPath="Text" Margin="0,0,0,14"/>
                                            <TextBlock Text="Đơn vị" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding NewFeeType.DefaultUnit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                            <TextBlock Text="Đơn giá mặc định" Margin="0,0,0,4"/>
                                            <TextBox helpers:MoneyTextBox.Enabled="True"
                                                     Text="{Binding NewFeeType.DefaultUnitPrice, UpdateSourceTrigger=LostFocus, StringFormat=N0}"
                                                     Margin="0,0,0,16"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Thêm mới" Command="{Binding AddFeeTypeCommand}"
                                                        Visibility="{Binding IsFeeTypeCreateMode, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,8,0" Padding="12,0"/>
                                                <Button Content="Lưu thay đổi" Command="{Binding SaveFeeTypeCommand}"
                                                        Visibility="{Binding IsFeeTypeEditMode, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,8,0" Padding="12,0"/>
                                                <Button Content="Hủy" Command="{Binding CloseFeeTypeDrawerCommand}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}" Padding="12,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="Người thuê">
                <Grid>
                    <TabControl TabStripPlacement="Top" Panel.ZIndex="1" SelectionChanged="TabControl_SelectionChanged">
            <TabItem x:Name="TenantsTab" Header="Danh sách người thuê">
                <DockPanel Margin="16,12,16,16">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Danh sách người thuê" FontSize="20" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="+ Thêm người thuê"
                                    Command="{Binding OpenAddTenantDrawerCommand}"
                                    Style="{StaticResource PrimaryAddButton}"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryHueLightBrush}" Padding="16,12" Margin="0,12,0,16" CornerRadius="4">
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="Tìm kiếm" Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"/><TextBox Text="{Binding TenantSearch, UpdateSourceTrigger=PropertyChanged}" Width="200" Foreground="{DynamicResource PrimaryHueLightForegroundBrush}" materialDesign:HintAssist.Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"/></StackPanel>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="Trạng thái thuê" Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"/><ComboBox ItemsSource="{Binding TenantStatusFilterOptions}" SelectedItem="{Binding TenantStatusFilter}" Width="150" Foreground="{DynamicResource PrimaryHueLightForegroundBrush}" materialDesign:HintAssist.Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"/></StackPanel>
                            <Button Content="Xóa lọc" Command="{Binding ClearFiltersCommand}" Style="{StaticResource MaterialDesignOutlinedLightButton}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredTenants}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,8" Padding="16,12" materialDesign:ElevationAssist.Elevation="Dp1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <materialDesign:PackIcon Kind="Phone" Width="14" Height="14" Opacity="0.6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Phone}" FontSize="13" Opacity="0.8"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CardAccountDetails" Width="14" Height="14" Opacity="0.6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding IdentityNumber}" FontSize="13" Opacity="0.8"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Border HorizontalAlignment="Left" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding CurrentRoomName}" FontSize="13" Opacity="0.75" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Button Content="Sửa" Command="{Binding DataContext.OpenEditTenantDrawerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="AssignmentsTab" Header="Phân phòng">
                <DockPanel Margin="16,12,16,16">
                    <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Text="Phân phòng — Quản lý người thuê theo phòng" Margin="0,0,0,12"/>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryHueLightBrush}" Padding="16,12" Margin="0,0,0,16" CornerRadius="4">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Xem lịch sử thuê" Command="{Binding OpenAssignmentHistoryDrawerCommand}" Style="{StaticResource MaterialDesignOutlinedLightButton}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <ListBox ItemsSource="{Binding PropertyFilterOptions}"
                                     SelectedValue="{Binding AssignmentFilterPropertyId}"
                                     SelectedValuePath="Id"
                                     Style="{StaticResource PropertySelectorListBox}"
                                     ItemContainerStyle="{StaticResource PropertySelectorItem}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Text="Chọn nhà để xem danh sách phòng. Bấm vào phòng để xem hoặc chỉnh người thuê." Opacity="0.75" Margin="0,0,0,6"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding UnassignedTenantCountText}" Opacity="0.75" Margin="0,0,0,8"/>
                    <GroupBox DockPanel.Dock="Top" Header="Bộ lọc phòng" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tìm phòng" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding AssignmentRoomSearch, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="Chỉ hiện phòng trống / chưa có người thuê" IsChecked="{Binding AssignmentVacantOnly}" VerticalAlignment="Bottom" Margin="24,0,0,4"/>
                            </Grid>
                    </GroupBox>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredAssignmentRooms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Width="320" MinHeight="260" Margin="0,0,12,12" Padding="16,14" materialDesign:ElevationAssist.Elevation="Dp1">
                                        <materialDesign:Card.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenAssignmentRoomDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        </materialDesign:Card.InputBindings>
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Top">
                                                <DockPanel Margin="0,0,0,6">
                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="4" Padding="8,4" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding RoomName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding PropertyName}" FontSize="13" Opacity="0.75" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                                <WrapPanel>
                                                    <Button Content="＋ Gán người" Command="{Binding DataContext.OpenAssignmentDrawerForRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Height="30" Padding="8,0" Margin="0,0,6,6"/>
                                                    <Button Content="Chi tiết" Command="{Binding DataContext.OpenAssignmentRoomDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="8,0" Margin="0,0,6,6" Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Content="Lịch sử" Command="{Binding DataContext.OpenAssignmentHistoryForRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="8,0" Margin="0,0,6,6"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <StackPanel>
                                                <TextBlock Text="Chưa có người thuê" FontStyle="Italic" Opacity="0.7" Margin="0,8,0,0" Visibility="{Binding IsVacant, Converter={StaticResource BoolToVis}}"/>
                                                <StackPanel Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Người đang ở:" FontWeight="SemiBold" Margin="0,4,0,6"/>
                                                    <ItemsControl ItemsSource="{Binding ActiveRoomTenants}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                                                    <StackPanel>
                                                                        <TextBlock>
                                                                            <Run Text="{Binding TenantName, Mode=OneWay}"/>
                                                                            <Run Text=" — "/>
                                                                            <Run Text="{Binding RepresentativeText, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding ActiveTenantCountText}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
