                                        <DataGridTextColumn Header="Khoản" Binding="{Binding ItemName}" Width="140"/>
                                        <DataGridTextColumn Header="SL" Binding="{Binding Quantity, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="60"/>
                                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="90"/>
                                        <DataGridTextColumn Header="Tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Thanh toán">
                                <DockPanel>
                                    <GroupBox DockPanel.Dock="Bottom" Header="Ghi nhận thanh toán mới" Margin="0,8,0,0">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding SelectedInvoiceSummary}" FontWeight="SemiBold" MinWidth="200" TextWrapping="Wrap" Margin="4,18,8,0"/>
                                            <StackPanel><TextBlock Text="Số tiền"/><TextBox helpers:MoneyTextBox.Enabled="True" Text="{Binding NewPaymentAmount, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Width="110"/></StackPanel>
                                            <StackPanel><TextBlock Text="Phương thức"/><ComboBox ItemsSource="{Binding PaymentMethodOptions}" SelectedValue="{Binding NewPaymentMethod}" SelectedValuePath="Value" DisplayMemberPath="Text" Width="120"/></StackPanel>
                                            <StackPanel><TextBlock Text="Ghi chú"/><TextBox Text="{Binding NewPaymentNote, UpdateSourceTrigger=PropertyChanged}" Width="130"/></StackPanel>
                                            <Button Content="Điền số còn lại" Command="{Binding FillRemainingPaymentCommand}" VerticalAlignment="Bottom"/>
                                            <Button Content="Thanh toán" Command="{Binding RecordPaymentCommand}" VerticalAlignment="Bottom"/>
                                        </WrapPanel>
                                    </GroupBox>
                                    <DataGrid ItemsSource="{Binding SelectedInvoicePayments}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ngày" Binding="{Binding PaymentDate, StringFormat=d}" Width="90"/>
                                        <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="100"/>
                                        <DataGridTextColumn Header="Phương thức" Binding="{Binding MethodText}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="PaymentsTab" Header="Lịch sử thanh toán">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Lịch sử thanh toán"/>
                    <GroupBox DockPanel.Dock="Top" Header="Tìm kiếm">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tháng"/><ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding PaymentFilterMonth}" Width="80"/></StackPanel>
                            <StackPanel><TextBlock Text="Năm"/><ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding PaymentFilterYear}" Width="90"/></StackPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding PropertyFilterOptions}" SelectedValue="{Binding PaymentFilterPropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="170"/></StackPanel>
                            <StackPanel><TextBlock Text="Phòng"/><ComboBox ItemsSource="{Binding Rooms}" SelectedValue="{Binding PaymentFilterRoomId}" SelectedValuePath="Id" DisplayMemberPath="RoomName" Width="120"/></StackPanel>
                            <StackPanel><TextBlock Text="Phương thức"/><ComboBox ItemsSource="{Binding PaymentMethodFilterOptions}" SelectedItem="{Binding PaymentFilterMethod}" Width="130"/></StackPanel>
                            <StackPanel><TextBlock Text="Người đại diện"/><TextBox Text="{Binding PaymentSearch}" Width="140"/></StackPanel>
                            <Button Content="Xóa lọc" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding FilteredPayments}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày trả" Binding="{Binding PaymentDate, StringFormat=d}" Width="110"/>
                            <DataGridTextColumn Header="Tháng" Binding="{Binding BillingMonth}" Width="90"/>
                            <DataGridTextColumn Header="Nhà / khu trọ" Binding="{Binding PropertyName}" Width="150"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="100"/>
                            <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="120"/>
                            <DataGridTextColumn Header="Phương thức" Binding="{Binding MethodText}" Width="120"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="240"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="Cài đặt">
                <TabControl TabStripPlacement="Top">
            <TabItem x:Name="SettingsTab" Header="Dữ liệu &amp; Sao lưu">
                <StackPanel Margin="16">
                    <TextBlock Text="Vị trí file dữ liệu" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" MinWidth="720"/>
                    <Button Content="Sao lưu ra Desktop\RentalManagerBackups" Width="280" HorizontalAlignment="Left" Command="{Binding BackupCommand}"/>
                    <Button Content="Khôi phục từ bản sao lưu" Width="280" HorizontalAlignment="Left" Command="{Binding RestoreCommand}"/>
                    <Button Content="Tạo dữ liệu mẫu" Width="280" HorizontalAlignment="Left" Command="{Binding SeedDemoDataCommand}"/>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="AutomationTab" Header="AI &amp; Tự động hóa">
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Tích hợp AI &amp; Automation"/>
                    
                    <materialDesign:Card DockPanel.Dock="Top" Margin="0,0,0,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Thông tin CLI" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                            <TextBlock Text="- CLI cho phép công cụ AI/automation thao tác với app thông qua dòng lệnh." TextWrapping="Wrap"/>
                            <TextBlock Text="- Dữ liệu vẫn nằm local trên máy người dùng, App không cần server online, không tự gửi dữ liệu ra ngoài." TextWrapping="Wrap" Margin="0,0,0,16"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Trạng thái CLI: " FontWeight="SemiBold" Width="120"/>
                                <TextBlock Text="{Binding CliStatusText}" Foreground="{Binding CliStatusColor}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Đường dẫn CLI: " FontWeight="SemiBold" Width="120"/>
                                <TextBox Text="{Binding ResolvedCliPath, Mode=OneWay}" IsReadOnly="True" MinWidth="400" Background="Transparent" BorderThickness="0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Đường dẫn DB: " FontWeight="SemiBold" Width="120"/>
                                <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" MinWidth="400" Background="Transparent" BorderThickness="0"/>
                            </StackPanel>
                            
                            <Button Content="Mở tài liệu (CLI_USAGE.md)" Command="{Binding OpenDocsCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Ví dụ các lệnh thường dùng:" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                            
                            <GroupBox Header="1. Ghi nhận chỉ số điện nước" Margin="0,0,0,8">
                                <TextBox Text="RentalManager.Cli.exe meter add --property &quot;Nhà A&quot; --room &quot;Phòng 202&quot; --fee &quot;Điện&quot; --month &quot;2026-04&quot; --current 160" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource MaterialDesignPaper}"/>
                            </GroupBox>
                            
                            <GroupBox Header="2. Tạo hóa đơn" Margin="0,0,0,8">
                                <TextBox Text="RentalManager.Cli.exe invoice create --property &quot;Nhà A&quot; --room &quot;Phòng 202&quot; --month &quot;2026-04&quot;" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource MaterialDesignPaper}"/>
                            </GroupBox>
                            
                            <GroupBox Header="3. Xem hóa đơn chưa thanh toán" Margin="0,0,0,8">
                                <TextBox Text="RentalManager.Cli.exe invoice unpaid --month &quot;2026-04&quot;" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource MaterialDesignPaper}"/>
                            </GroupBox>
                            
                            <GroupBox Header="4. Ghi nhận thanh toán" Margin="0,0,0,8">
                                <TextBox Text="RentalManager.Cli.exe payment add --invoice 12 --amount 3550000 --method &quot;BankTransfer&quot; --note &quot;Chuyển khoản&quot;" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource MaterialDesignPaper}"/>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
