<Window x:Class="RentalManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý nhà trọ" Height="780" Width="1240" MinHeight="680" MinWidth="1040">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,4,2"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10,8,10,2"/>
        </Style>
        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#20242b" Padding="12">
            <DockPanel>
                <TextBlock Text="Quản lý nhà trọ" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Tháng tính tiền" Foreground="White"/>
                    <TextBox Text="{Binding BillingMonth, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <Button Content="Làm mới" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusMessage}"/>
        </StatusBar>

        <TabControl>
            <TabItem Header="Tổng quan">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Tổng quan tháng"/>
                    <GroupBox DockPanel.Dock="Top" Header="Bộ lọc">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tháng tính tiền"/><TextBox Text="{Binding BillingMonth, UpdateSourceTrigger=PropertyChanged}" Width="100"/></StackPanel>
                            <StackPanel><TextBlock Text="Năm"/><TextBox Text="{Binding DashboardYear, UpdateSourceTrigger=PropertyChanged}" Width="80"/></StackPanel>
                            <StackPanel><TextBlock Text="Khoảng thời gian"/><ComboBox ItemsSource="{Binding DashboardRangeOptions}" SelectedItem="{Binding DashboardRange}" Width="170"/></StackPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding PropertyFilterOptions}" SelectedValue="{Binding DashboardPropertyFilterId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="190"/></StackPanel>
                            <TextBlock Text="{Binding ActiveDashboardPeriod}" FontWeight="SemiBold" Margin="12,18,4,0"/>
                        </WrapPanel>
                    </GroupBox>
                    <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="7" Margin="8">
                        <GroupBox Header="Dự kiến thu"><TextBlock Text="{Binding Dashboard.ExpectedRevenue, StringFormat=N0}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Đã thu"><TextBlock Text="{Binding Dashboard.CollectedAmount, StringFormat=N0}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Chưa thu"><TextBlock Text="{Binding Dashboard.UnpaidAmount, StringFormat=N0}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Phòng đang thuê"><TextBlock Text="{Binding Dashboard.OccupiedRoomCount}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Phòng trống"><TextBlock Text="{Binding Dashboard.VacantRoomCount}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Thiếu chỉ số"><TextBlock Text="{Binding Dashboard.MissingReadingCount}" FontSize="18"/></GroupBox>
                        <GroupBox Header="Hóa đơn chưa trả"><TextBlock Text="{Binding Dashboard.UnpaidInvoiceCount}" FontSize="18"/></GroupBox>
                    </UniformGrid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.2*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Hóa đơn chưa thu" Grid.Row="0" Grid.Column="0">
                            <DataGrid ItemsSource="{Binding DashboardUnpaidInvoices}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tháng" Binding="{Binding BillingMonth}" Width="75"/>
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="90"/>
                                    <DataGridTextColumn Header="Người đại diện" Binding="{Binding RepresentativeTenantName}" Width="140"/>
                                    <DataGridTextColumn Header="Còn lại" Binding="{Binding RemainingAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Header="Phòng thiếu chỉ số" Grid.Row="0" Grid.Column="1">
                            <DataGrid ItemsSource="{Binding DashboardMissingReadings}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nhà" Binding="{Binding PropertyName}" Width="120"/>
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="90"/>
                                    <DataGridTextColumn Header="Loại phí" Binding="{Binding FeeTypeName}" Width="100"/>
                                    <DataGridTextColumn Header="Chỉ số trước" Binding="{Binding PreviousReading, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Header="Thanh toán gần đây" Grid.Row="1" Grid.Column="0">
                            <DataGrid ItemsSource="{Binding DashboardRecentPayments}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ngày" Binding="{Binding PaymentDate, StringFormat=d}" Width="90"/>
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="90"/>
                                    <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                    <DataGridTextColumn Header="Phương thức" Binding="{Binding MethodText}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Header="Hóa đơn trong khoảng đang xem" Grid.Row="1" Grid.Column="1">
                            <DataGrid ItemsSource="{Binding DashboardInvoices}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tháng" Binding="{Binding BillingMonth}" Width="75"/>
                                    <DataGridTextColumn Header="Nhà" Binding="{Binding PropertyName}" Width="120"/>
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="90"/>
                                    <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Phòng">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Quản lý phòng"/>
                    <GroupBox DockPanel.Dock="Top" Header="{Binding RoomFormMode}">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tìm kiếm"/><TextBox Text="{Binding RoomSearch, UpdateSourceTrigger=PropertyChanged}" Width="180"/></StackPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding Properties}" SelectedValue="{Binding NewRoom.PropertyId}" SelectedValuePath="Id" DisplayMemberPath="Name"/></StackPanel>
                            <StackPanel><TextBlock Text="Tên phòng"/><TextBox Text="{Binding NewRoom.RoomName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Tầng"/><TextBox Text="{Binding NewRoom.Floor, UpdateSourceTrigger=PropertyChanged}" Width="80"/></StackPanel>
                            <StackPanel><TextBlock Text="Tiền phòng"/><TextBox Text="{Binding NewRoom.BaseRent, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Trạng thái"/><ComboBox ItemsSource="{Binding RoomFormStatusOptions}" SelectedValue="{Binding NewRoom.Status}" SelectedValuePath="Value" DisplayMemberPath="Text"/></StackPanel>
                            <Button Content="Thêm mới" Command="{Binding AddRoomCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Lưu thay đổi" Command="{Binding SaveRoomCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Sửa dòng chọn" Command="{Binding EditRoomCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Ngừng sử dụng" Command="{Binding DeactivateRoomCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding FilteredRooms}" SelectedItem="{Binding SelectedRoom}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhà / khu trọ" Binding="{Binding PropertyName}" Width="170"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="120"/>
                            <DataGridTextColumn Header="Tầng" Binding="{Binding Floor}" Width="80"/>
                            <DataGridTextColumn Header="Tiền phòng" Binding="{Binding BaseRent, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="120"/>
                            <DataGridTextColumn Header="Người đại diện" Binding="{Binding RepresentativeTenantName}" Width="170"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="130"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Chỉ số điện nước">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Nhập chỉ số điện nước"/>
                    <GroupBox DockPanel.Dock="Top" Header="Nhập chỉ số">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Phòng"/><ComboBox ItemsSource="{Binding Rooms}" SelectedValue="{Binding NewMeterReading.RoomId}" SelectedValuePath="Id" DisplayMemberPath="RoomName"/></StackPanel>
                            <StackPanel><TextBlock Text="Loại phí"/><ComboBox ItemsSource="{Binding FeeTypes}" SelectedValue="{Binding NewMeterReading.FeeTypeId}" SelectedValuePath="Id" DisplayMemberPath="DisplayName"/></StackPanel>
                            <StackPanel><TextBlock Text="Chỉ số cũ"/><TextBox Text="{Binding NewMeterReading.PreviousReading, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Chỉ số mới"/><TextBox Text="{Binding NewMeterReading.CurrentReading, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Ghi chú"/><TextBox Text="{Binding NewMeterReading.Note, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <Button Content="Lưu chỉ số" Command="{Binding AddMeterReadingCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding MeterReadings}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tháng" Binding="{Binding BillingMonth}" Width="90"/>
                            <DataGridTextColumn Header="Nhà / khu trọ" Binding="{Binding PropertyName}" Width="150"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="100"/>
                            <DataGridTextColumn Header="Loại phí" Binding="{Binding FeeTypeName}" Width="130"/>
                            <DataGridTextColumn Header="Chỉ số cũ" Binding="{Binding PreviousReading, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="100"/>
                            <DataGridTextColumn Header="Chỉ số mới" Binding="{Binding CurrentReading, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="100"/>
                            <DataGridTextColumn Header="Sử dụng" Binding="{Binding UsageAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="100"/>
                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPriceSnapshot, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Hóa đơn">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Tạo và theo dõi hóa đơn"/>
                    <GroupBox DockPanel.Dock="Top" Header="Sẵn sàng tạo hóa đơn">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Tạo hóa đơn cho phòng đủ dữ liệu" Command="{Binding GenerateReadyInvoicesCommand}" Margin="8"/>
                            <DataGrid ItemsSource="{Binding InvoiceReadinessRows}" Height="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nhà" Binding="{Binding PropertyName}" Width="160"/>
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="120"/>
                                    <DataGridTextColumn Header="Tình trạng" Binding="{Binding StatusText}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Top" Header="Thao tác hóa đơn">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tìm kiếm"/><TextBox Text="{Binding InvoiceSearch, UpdateSourceTrigger=PropertyChanged}" Width="180"/></StackPanel>
                            <StackPanel><TextBlock Text="Phòng"/><ComboBox ItemsSource="{Binding Rooms}" SelectedValue="{Binding InvoiceRoomId}" SelectedValuePath="Id" DisplayMemberPath="RoomName"/></StackPanel>
                            <Button Content="Tạo hóa đơn" Command="{Binding GenerateInvoiceCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Tạo tất cả" Command="{Binding GenerateAllInvoicesCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Chốt hóa đơn" Command="{Binding IssueInvoiceCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Sao chép" Command="{Binding CopyInvoiceCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Hủy hóa đơn" Command="{Binding CancelInvoiceCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Top" Header="Thanh toán cho hóa đơn đang chọn">
                        <WrapPanel>
                            <TextBlock Text="{Binding SelectedInvoiceSummary}" FontWeight="SemiBold" MinWidth="430"/>
                            <StackPanel><TextBlock Text="Số tiền"/><TextBox Text="{Binding NewPaymentAmount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Phương thức"/><ComboBox ItemsSource="{Binding PaymentMethodOptions}" SelectedValue="{Binding NewPaymentMethod}" SelectedValuePath="Value" DisplayMemberPath="Text"/></StackPanel>
                            <StackPanel><TextBlock Text="Ghi chú"/><TextBox Text="{Binding NewPaymentNote, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <Button Content="Điền số còn lại" Command="{Binding FillRemainingPaymentCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Ghi nhận thanh toán" Command="{Binding RecordPaymentCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid Grid.Column="0" ItemsSource="{Binding FilteredInvoices}" SelectedItem="{Binding SelectedInvoice}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tháng" Binding="{Binding BillingMonth}" Width="80"/>
                                <DataGridTextColumn Header="Nhà / khu trọ" Binding="{Binding PropertyName}" Width="150"/>
                                <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="100"/>
                                <DataGridTextColumn Header="Người đại diện" Binding="{Binding RepresentativeTenantName}" Width="150"/>
                                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="115"/>
                                <DataGridTextColumn Header="Đã thu" Binding="{Binding PaidAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                <DataGridTextColumn Header="Còn lại" Binding="{Binding RemainingAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="115"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TabControl Grid.Column="1" Margin="4">
                            <TabItem Header="Chi tiết">
                                <DataGrid ItemsSource="{Binding SelectedInvoiceItems}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Khoản" Binding="{Binding ItemName}" Width="140"/>
                                        <DataGridTextColumn Header="SL" Binding="{Binding Quantity, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="60"/>
                                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="90"/>
                                        <DataGridTextColumn Header="Tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Thanh toán">
                                <DataGrid ItemsSource="{Binding SelectedInvoicePayments}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ngày" Binding="{Binding PaymentDate, StringFormat=d}" Width="90"/>
                                        <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="100"/>
                                        <DataGridTextColumn Header="Phương thức" Binding="{Binding MethodText}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Thanh toán">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Lịch sử thanh toán"/>
                    <GroupBox DockPanel.Dock="Top" Header="Tìm kiếm">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tìm theo tháng, nhà, phòng, phương thức"/><TextBox Text="{Binding PaymentSearch, UpdateSourceTrigger=PropertyChanged}" Width="260"/></StackPanel>
                        </WrapPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding FilteredPayments}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày trả" Binding="{Binding PaymentDate, StringFormat=d}" Width="110"/>
                            <DataGridTextColumn Header="Tháng" Binding="{Binding BillingMonth}" Width="90"/>
                            <DataGridTextColumn Header="Nhà / khu trọ" Binding="{Binding PropertyName}" Width="150"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="100"/>
                            <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="120"/>
                            <DataGridTextColumn Header="Phương thức" Binding="{Binding MethodText}" Width="120"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="240"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Người thuê">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Người thuê và phân phòng"/>
                    <GroupBox DockPanel.Dock="Top" Header="{Binding TenantFormMode}">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tìm kiếm"/><TextBox Text="{Binding TenantSearch, UpdateSourceTrigger=PropertyChanged}" Width="180"/></StackPanel>
                            <StackPanel><TextBlock Text="Họ tên"/><TextBox Text="{Binding NewTenant.FullName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Số điện thoại"/><TextBox Text="{Binding NewTenant.Phone, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Email"/><TextBox Text="{Binding NewTenant.Email, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="CCCD/CMND"/><TextBox Text="{Binding NewTenant.IdentityNumber, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <Button Content="Thêm mới" Command="{Binding AddTenantCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Lưu thay đổi" Command="{Binding SaveTenantCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Sửa dòng chọn" Command="{Binding EditTenantCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Top" Header="Gán người thuê vào phòng">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Phòng"/><ComboBox ItemsSource="{Binding Rooms}" SelectedValue="{Binding NewRoomTenant.RoomId}" SelectedValuePath="Id" DisplayMemberPath="RoomName"/></StackPanel>
                            <StackPanel><TextBlock Text="Người thuê"/><ComboBox ItemsSource="{Binding Tenants}" SelectedValue="{Binding NewRoomTenant.TenantId}" SelectedValuePath="Id" DisplayMemberPath="FullName"/></StackPanel>
                            <CheckBox Content="Người đại diện" IsChecked="{Binding NewRoomTenant.IsRepresentative}" VerticalAlignment="Bottom" Margin="8"/>
                            <Button Content="Thêm / Lưu" Command="{Binding AssignTenantCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <DataGrid Grid.Column="0" ItemsSource="{Binding FilteredTenants}" SelectedItem="{Binding SelectedTenant}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="160"/>
                                <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" Width="120"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160"/>
                                <DataGridTextColumn Header="CCCD/CMND" Binding="{Binding IdentityNumber}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Column="1" ItemsSource="{Binding RoomTenants}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nhà / khu trọ" Binding="{Binding PropertyName}" Width="140"/>
                                <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="100"/>
                                <DataGridTextColumn Header="Người thuê" Binding="{Binding TenantName}" Width="150"/>
                                <DataGridTextColumn Header="Đại diện" Binding="{Binding IsRepresentative}" Width="80"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Phí theo phòng">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Phí theo phòng"/>
                    <GroupBox DockPanel.Dock="Top" Header="Bộ lọc và cấu hình">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tìm kiếm"/><TextBox Text="{Binding RoomFeeSearch, UpdateSourceTrigger=PropertyChanged}" Width="160"/></StackPanel>
                            <StackPanel><TextBlock Text="Nhà / khu trọ"/><ComboBox ItemsSource="{Binding Properties}" SelectedValue="{Binding RoomFeePropertyFilterId}" SelectedValuePath="Id" DisplayMemberPath="Name"/></StackPanel>
                            <StackPanel><TextBlock Text="Phòng"/><ComboBox ItemsSource="{Binding Rooms}" SelectedValue="{Binding NewRoomFeeConfig.RoomId}" SelectedValuePath="Id" DisplayMemberPath="RoomName"/></StackPanel>
                            <StackPanel><TextBlock Text="Loại phí"/><ComboBox ItemsSource="{Binding FeeTypes}" SelectedValue="{Binding NewRoomFeeConfig.FeeTypeId}" SelectedValuePath="Id" DisplayMemberPath="DisplayName"/></StackPanel>
                            <StackPanel><TextBlock Text="Cách tính"/><ComboBox ItemsSource="{Binding CalculationTypeOptions}" SelectedValue="{Binding NewRoomFeeConfig.CalculationType}" SelectedValuePath="Value" DisplayMemberPath="Text"/></StackPanel>
                            <StackPanel><TextBlock Text="Đơn giá"/><TextBox Text="{Binding NewRoomFeeConfig.UnitPrice, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Cố định"/><TextBox Text="{Binding NewRoomFeeConfig.FixedAmount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Số lượng"/><TextBox Text="{Binding NewRoomFeeConfig.Quantity, UpdateSourceTrigger=PropertyChanged}" Width="90"/></StackPanel>
                            <CheckBox Content="Đang áp dụng" IsChecked="{Binding NewRoomFeeConfig.Enabled}" VerticalAlignment="Bottom" Margin="8"/>
                            <Button Content="Thêm mới" Command="{Binding AddRoomFeeConfigCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Sửa dòng chọn" Command="{Binding EditRoomFeeConfigCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Lưu thay đổi" Command="{Binding SaveRoomFeeConfigCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Ngừng áp dụng" Command="{Binding DisableRoomFeeConfigCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding FilteredRoomFeeConfigs}" SelectedItem="{Binding SelectedRoomFeeConfig}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhà / khu trọ" Binding="{Binding PropertyName}" Width="150"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="100"/>
                            <DataGridTextColumn Header="Loại phí" Binding="{Binding FeeTypeName}" Width="130"/>
                            <DataGridTextColumn Header="Cách tính" Binding="{Binding CalculationTypeText}" Width="120"/>
                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                            <DataGridTextColumn Header="Cố định" Binding="{Binding FixedAmount, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="110"/>
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="90"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding EnabledText}" Width="120"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Loại phí">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Loại phí"/>
                    <GroupBox DockPanel.Dock="Top" Header="{Binding FeeTypeFormMode}">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tên loại phí"/><TextBox Text="{Binding NewFeeType.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Cách tính"/><ComboBox ItemsSource="{Binding CalculationTypeOptions}" SelectedValue="{Binding NewFeeType.DefaultCalculationType}" SelectedValuePath="Value" DisplayMemberPath="Text"/></StackPanel>
                            <StackPanel><TextBlock Text="Đơn vị"/><TextBox Text="{Binding NewFeeType.DefaultUnit, UpdateSourceTrigger=PropertyChanged}" Width="100"/></StackPanel>
                            <StackPanel><TextBlock Text="Đơn giá mặc định"/><TextBox Text="{Binding NewFeeType.DefaultUnitPrice, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <Button Content="Thêm mới" Command="{Binding AddFeeTypeCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Sửa dòng chọn" Command="{Binding EditFeeTypeCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Lưu thay đổi" Command="{Binding SaveFeeTypeCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Ngừng sử dụng" Command="{Binding DeactivateFeeTypeCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding FeeTypes}" SelectedItem="{Binding SelectedFeeType}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên phí" Binding="{Binding DisplayName}" Width="160"/>
                            <DataGridTextColumn Header="Cách tính" Binding="{Binding CalculationTypeText}" Width="130"/>
                            <DataGridTextColumn Header="Đơn vị" Binding="{Binding DefaultUnit}" Width="100"/>
                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding DefaultUnitPrice, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" Width="120"/>
                            <DataGridTextColumn Header="Loại hệ thống" Binding="{Binding SystemStatusText}" Width="110"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding ActiveStatusText}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Nhà / Khu trọ">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Nhà / khu trọ"/>
                    <GroupBox DockPanel.Dock="Top" Header="{Binding PropertyFormMode}">
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Tên nhà / khu trọ"/><TextBox Text="{Binding NewProperty.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Địa chỉ"/><TextBox Text="{Binding NewProperty.Address, UpdateSourceTrigger=PropertyChanged}" MinWidth="240"/></StackPanel>
                            <StackPanel><TextBlock Text="Ghi chú"/><TextBox Text="{Binding NewProperty.Note, UpdateSourceTrigger=PropertyChanged}" MinWidth="240"/></StackPanel>
                            <Button Content="Thêm mới" Command="{Binding AddPropertyCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Lưu thay đổi" Command="{Binding SavePropertyCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Sửa dòng chọn" Command="{Binding EditPropertyCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Ngừng sử dụng" Command="{Binding DeactivatePropertyCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>
                    <DataGrid ItemsSource="{Binding Properties}" SelectedItem="{Binding SelectedProperty}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên nhà / khu trọ" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" Width="260"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="220"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding ActiveStatusText}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Cài đặt">
                <StackPanel Margin="16">
                    <TextBlock Text="Vị trí file dữ liệu" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" MinWidth="720"/>
                    <Button Content="Sao lưu ra Desktop\RentalManagerBackups" Width="280" HorizontalAlignment="Left" Command="{Binding BackupCommand}"/>
                    <Button Content="Khôi phục từ bản sao lưu" Width="280" HorizontalAlignment="Left" Command="{Binding RestoreCommand}"/>
                    <Button Content="Tạo dữ liệu mẫu" Width="280" HorizontalAlignment="Left" Command="{Binding SeedDemoDataCommand}"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
